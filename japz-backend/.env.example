# ===========================================
# JAPZ POS Backend Configuration
# ===========================================

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_DATABASE=japz_pos
DB_PORT=3306

# JWT Secret
JWT_SECRET=your-secret-key-change-in-production

# Node Environment
NODE_ENV=development
PORT=3000

# ===========================================
# Feedback Hub Configuration
# ===========================================

# Google Sheets API Configuration (for Google Forms integration)
# Get API key from: https://console.cloud.google.com
# 1. Create a project
# 2. Enable Google Sheets API  
# 3. Create API credentials (API Key)
GOOGLE_SHEETS_API_KEY=
GOOGLE_SPREADSHEET_ID=

# Gemma AI Configuration (Optional - for advanced feedback analysis)
# Get API key from: https://www.together.ai/
# Leave blank to use keyword-based analysis instead
GEMMA_API_KEY=
GEMMA_MODEL=mistralai/Mistral-7B-Instruct-v0.1
GEMMA_ENDPOINT=https://api.together.xyz/v1/chat/completions
USE_GEMMA=false

# ===========================================
# Email Configuration (Mailjet REST API)
# ===========================================
# Get keys from: https://app.mailjet.com/account/apikeys
# Free tier: 200 emails/day, instant activation
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# Must be a verified sender address in your Mailjet account
MAILJET_FROM_EMAIL=

# Public URL of the frontend, used in email links and QR codes
FRONTEND_URL=http://localhost:5173

# ---------- PayMongo (card + GCash) ----------
# Get these from https://dashboard.paymongo.com -> Developers -> API Keys.
# Start with the TEST keys (sk_test_... / pk_test_...). Card and GCash stay
# switched off entirely while PAYMONGO_SECRET_KEY is unset - cash still works.
PAYMONGO_SECRET_KEY=sk_test_F2Dqn8AX6sgEv6JkMrrSxQEH
PAYMONGO_PUBLIC_KEY=pk_test_LLJyvL3KV3Eam5Ch6uJC214S

# Created when you register the webhook (see docs/paymongo-setup.md).
# Without it every webhook is rejected, and payment is confirmed only by the
# read-back when the customer returns from checkout.
PAYMONGO_WEBHOOK_SECRET=

# Methods to offer, comma separated. Supported here: card, gcash, paymaya,
# grab_pay, billease, dob, atome. Each must also be enabled on your account.
PAYMONGO_METHODS=card,gcash

# PayMongo enforces a per-account MINIMUM CHARGE that is not published in the
# API reference and is adjusted by their support team. In centavos.
# 10000 = P100.00. Set to your account's real floor, or 0 to remove the
# pre-check and let PayMongo reject undersized charges itself.
PAYMONGO_MIN_AMOUNT=10000

# Public origin used to build PayMongo's return URLs. On localhost leave unset
# and it is derived from the request; set it in production.
APP_ORIGIN=
