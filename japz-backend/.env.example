# ===========================================
# JAPZ POS Backend Configuration
# ===========================================

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_DATABASE=japz_pos
DB_PORT=3306

# JWT signing key: generate a unique random value with at least 32 bytes
# Generate locally: node -e "process.stdout.write(require('node:crypto').randomBytes(48).toString('base64url'))"
# Save only in your private .env; never commit the generated value.
JWT_SECRET=

# Optional first-time account setup; blank values create no accounts
# Passwords must be unique and contain 12 to 72 UTF-8 bytes.
# Startup creates the configured Admin on an empty database.
# After initial startup, npm run seed creates configured Cashier/Kitchen accounts.
# Existing accounts are preserved. Remove bootstrap passwords after setup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_CASHIER_EMAIL=
BOOTSTRAP_CASHIER_PASSWORD=
BOOTSTRAP_KITCHEN_EMAIL=
BOOTSTRAP_KITCHEN_PASSWORD=

# Email integration (optional; use a verified sender)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=

# Node Environment
NODE_ENV=development
PORT=3000

# ===========================================
# Feedback Hub Configuration
# ===========================================

# Google Sheets API Configuration (for Google Forms integration)
# Get API key from: https://console.cloud.google.com
# 1. Create a project
# 2. Enable Google Sheets API  
# 3. Create API credentials (API Key)
GOOGLE_SHEETS_API_KEY=
GOOGLE_SPREADSHEET_ID=

# Gemma AI Configuration (Optional - for advanced feedback analysis)
# Get API key from: https://www.together.ai/
# Leave blank to use keyword-based analysis instead
GEMMA_API_KEY=
GEMMA_MODEL=mistralai/Mistral-7B-Instruct-v0.1
GEMMA_ENDPOINT=https://api.together.xyz/v1/chat/completions
USE_GEMMA=false
