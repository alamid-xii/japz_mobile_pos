';\r\nimport { ChevronLeft, Banknote, CreditCard, Smartphone, Check, User, UtensilsCrossed, ShoppingBag, Truck, Gift, Receipt } from 'lucide-react';\r\nimport api, { discountsVouchersAPI } from '../../services/api';\r\nimport { isAxiosError } from 'axios';\r\n\r\ntype PaymentMethod = 'cash' | 'card' | 'digital';\r\ntype OrderType = 'dine-in' | 'take-out' | 'delivery';\r\n\r\ninterface CartStockItem {\r\n    id: number | string;\r\n    quantity: number;\r\n    selectedSize?: string | null;\r\n    selectedFlavor?: string | null;\r\n    selectedTemperature?: string | null;\r\n}\r\n\r\nexport default function PaymentSelection() {\r\n    const navigate = useNavigate();\r\n    const location = useLocation();\r\n    const { total, items, itemCount } = (location.state as any) || {};\r\n    const [paymentMethod, setPaymentMethod] = useState<PaymentMethod>('cash');\r\n    const [discounts, setDiscounts] = useState<any[]>([]);\r\n    const [selectedDiscount, setSelectedDiscount] = useState<any>(null);\r\n    const [voucherCode, setVoucherCode] = useState('');\r\n    const [voucherError, setVoucherError] = useState('');\r\n    const [appliedVoucher, setAppliedVoucher] = useState<any>(null);\r\n    const [customerName, setCustomerName] = useState('');\r\n    const [orderType, setOrderType] = useState<OrderType | ''>('');\r\n    const [tableNumber, setTableNumber] = useState('');\r\n    const [deliveryAddress, setDeliveryAddress] = useState('');\r\n    const [notes, setNotes] = useState('');\r\n    const [errors, setErrors] = useState<Record<string, string>>({});\r\n    const [checkingStock, setCheckingStock] = useState(false);\r\n\r\n    useEffect(() => {\r\n        const fetchDiscounts = async () => {\r\n            try {\r\n                const response = await discountsVouchersAPI.getDiscounts();\r\n                const enabledDiscounts = response.data.filter((d: any) => d.enabled);\r\n                setDiscounts(enabledDiscounts);\r\n            } catch (error) {\r\n                console.error('Error fetching discounts:', error);\r\n            }\r\n        };\r\n        fetchDiscounts();\r\n    }, []);\r\n\r\n    const subtotal = Number(total || 0);\r\n    const discountAmount = selectedDiscount\r\n        ? (subtotal * selectedDiscount.percentage) / 100\r\n        : 0;\r\n    const voucherAmount = appliedVoucher ? Number(appliedVoucher.amount) || 0 : 0;\r\n    const finalTotal = Math.max(0, subtotal - discountAmount - voucherAmount);\r\n\r\n    if (!total) return <div className=\"flex flex-col items-center justify-center h-full text-gray-500 gap-2 py-8\"><h1 className=\"text-xl font-semibold text-gray-900\">No order to check out</h1><p>Add items from the menu to start an order.</p><button className=\"mt-4 px-5 py-3 bg-brand text-brand-dark rounded-md font-semibold\" onClick={() => navigate('/cashier/pos')}>Back to POS</button></div>;\r\n\r\n    const validateVoucher = async () => {\r\n        if (!voucherCode.trim()) {\r\n            setVoucherError('');\r\n            setAppliedVoucher(null);\r\n            return;\r\n        }\r\n\r\n        try {\r\n            const vouchers = await discountsVouchersAPI.getVouchers();\r\n            const voucher = vouchers.data.find((v: any) => v.code === voucherCode.toUpperCase());\r\n\r\n            if (!voucher) {\r\n                setVoucherError('Voucher code not found');\r\n                setAppliedVoucher(null);\r\n                return;\r\n            }\r\n\r\n            if (voucher.used) {\r\n                setVoucherError('This voucher has already been used');\r\n                setAppliedVoucher(null);\r\n                return;\r\n            }\r\n\r\n            if (!voucher.enabled) {\r\n                setVoucherError('This voucher is disabled');\r\n                setAppliedVoucher(null);\r\n                return;\r\n            }\r\n\r\n            const now = new Date();\r\n            const start = new Date(voucher.startDate);\r\n            const end = new Date(voucher.endDate);\r\n\r\n            if (now < start || now > end) {\r\n                setVoucherError('This voucher is not valid for today');\r\n                setAppliedVoucher(null);\r\n                return;\r\n            }\r\n\r\n            setAppliedVoucher(voucher);\r\n            setVoucherError('');\r\n        } catch (error) {\r\n            setVoucherError('Error validating voucher');\r\n            setAppliedVoucher(null);\r\n        }\r\n    };\r\n\r\n    const validate = (): boolean => {\r\n        const newErrors: Record<string, string> = {};\r\n        if (!customerName.trim()) newErrors.customerName = 'Customer name is required';\r\n        if (!orderType) newErrors.orderType = 'Please select an order type';\r\n        if (orderType === 'dine-in' && !tableNumber.trim()) newErrors.tableNumber = 'Table number is required for dine-in';\r\n        if (orderType === 'delivery' && !deliveryAddress.trim()) newErrors.deliveryAddress = 'Delivery address is required';\r\n        setErrors(newErrors);\r\n        return Object.keys(newErrors).length === 0;\r\n    };\r\n\r\n    const handleProceed = async () => {\r\n        if (checkingStock || !validate()) return;\r\n        setCheckingStock(true);\r\n        try {\r\n            await api.post('/api/inventory/cart-check', { orderType, items: (items || []).map((item: CartStockItem) => ({ id: item.id, quantity: item.quantity, modifiers: { size: item.selectedSize || null, flavor: item.selectedFlavor || null, temperature: item.selectedTemperature || null } })) });\r\n        } catch (error) {\r\n            const message = isAxiosError<{ error?: string }>(error) ? error.response?.data?.error : undefined;\r\n            setErrors(previous => ({ ...previous, stock: message || 'Could not check stock. Try again.' }));\r\n            setCheckingStock(false); return;\r\n        }\r\n        setCheckingStock(false);\r\n        navigate('/cashier/cash-payment', {\r\n            state: {\r\n                total: finalTotal.toFixed(2),\r\n                subtotal: subtotal.toFixed(2),\r\n                discount: discountAmount.toFixed(2),\r\n                discountPercent: selectedDiscount ? selectedDiscount.percentage : 0,\r\n                discountId: selectedDiscount ? selectedDiscount.id : undefined,\r\n                voucherCode: appliedVoucher ? appliedVoucher.code : undefined,\r\n                voucherAmount: appliedVoucher ? appliedVoucher.amount : undefined,\r\n                items,\r\n                itemCount,\r\n                paymentMethod,\r\n                customerName: customerName.trim(),\r\n                orderType,\r\n                tableNumber: orderType === 'dine-in' ? tableNumber.trim() : undefined,\r\n                deliveryAddress: orderType === 'delivery' ? deliveryAddress.trim() : undefined,\r\n                notes: notes.trim() || undefined\r\n            }\r\n        });\r\n    };\r\n\r\n    const methods: { key: PaymentMethod; label: string; icon: typeof Banknote; enabled: boolean }[] = [\r\n        { key: 'cash', label: 'Cash Payment', icon: Banknote, enabled: true },\r\n        { key: 'card', label: 'Card Payment', icon: CreditCard, enabled: true },\r\n        { key: 'digital', label: 'Digital Payment', icon: Smartphone, enabled: true },\r\n    ];\r\n\r\n    const orderTypes: { key: OrderType; label: string; icon: typeof UtensilsCrossed }[] = [\r\n        { key: 'dine-in', label: 'Dine In', icon: UtensilsCrossed },\r\n        { key: 'take-out', label: 'Takeout', icon: ShoppingBag },\r\n        { key: 'delivery', label: 'Delivery', icon: Truck },\r\n    ];\r\n\r\n    return (\r\n        <div className=\"min-h-full flex flex-col items-center p-5 md:p-8 md:pt-12\">\r\n            <div className=\"w-full max-w-3xl\">\r\n                {errors.stock && <div role=\"alert\" className=\"p-3 mb-4 border border-red-200 bg-red-50 text-red-800 rounded-md text-sm\">{errors.stock}<button className=\"block min-h-11 underline\" onClick={() => navigate('/cashier/pos')}>Return to cart</button></div>}\r\n                <div className=\"relative flex justify-center mb-6\">\r\n                    <button className=\"absolute left-0 inline-flex items-center gap-1.5 px-4 py-2 border border-gray-200 rounded-lg bg-white hover:bg-gray-50 cursor-pointer font-medium text-sm\"\r\n                        onClick={() => navigate(-1)}>\r\n                        <ChevronLeft size={18} /> Back\r\n                    </button>\r\n                    <h1 className=\"text-xl md:text-2xl font-bold\">Complete Order</h1>\r\n                </div>\r\n\r\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\r\n                    {/* Left Column - Order Details */}\r\n                    <div className=\"space-y-6\">\r\n                        {/* Order Details Header */}\r\n                        <div className=\"border-b-2 border-brand pb-2 mb-4\">\r\n                            <h2 className=\"text-lg font-bold text-gray-900 flex items-center gap-2\">\r\n                                <Receipt size={20} className=\"text-brand\" />\r\n                                Order Details\r\n                            </h2>\r\n                        </div>\r\n                        {/* Customer Name */}\r\n                        <div>\r\n                            <label htmlFor=\"paymentselection-field-1\" className=\"text-sm font-semibold text-gray-700 mb-2 block\">\r\n                                Customer Name <span className=\"text-red-500\">*</span>\r\n                            </label>\r\n                            <div className=\"relative\">\r\n                                <User size={18} className=\"absolute left-3 top-1/2 -translate-y-1/2 text-gray-400\" />\r\n                                <input id=\"paymentselection-field-1\"\r\n                                    type=\"text\"\r\n                                    placeholder=\"Enter customer name\"\r\n                                    value={customerName}\r\n                                    onChange={(e) => { setCustomerName(e.target.value); setErrors(prev => ({ ...prev, customerName: '' })); }}\r\n                                    className={`w-full pl-10 pr-4 py-3 border rounded-xl text-base outline-none transition font-[inherit] ${errors.customerName ? 'border-red-400 focus:border-red-500 focus:ring-2 focus:ring-red-200' : 'border-gray-200 focus:border-brand focus:ring-2 focus:ring-brand/20'}`}\r\n                                />\r\n                            </div>\r\n                        </div>\r\n\r\n                        {/* Order Type */}\r\n                        <div>\r\n                            <label className=\"text-sm font-semibold text-gray-700 mb-2 block\">\r\n                                Order Type <span className=\"text-red-500\">*</span>\r\n                            </label>\r\n                            <div className={`grid grid-cols-3 gap-2 ${errors.orderType ? 'ring-2 ring-red-300 rounded-xl p-1' : ''}`}>\r\n                                {orderTypes.map(({ key, label, icon: Icon }) => (\r\n                                    <button\r\n                                        key={key}\r\n                                        onClick={() => { setOrderType(key); setErrors(prev => ({ ...prev, orderType: '', tableNumber: '', deliveryAddress: '' })); }}\r\n                                        className={`flex flex-col items-center gap-1.5 p-3 rounded-xl border-2 transition font-[inherit] cursor-pointer ${orderType === key\r\n                                            ? 'bg-brand border-brand'\r\n                                            : errors.orderType\r\n                                                ? 'bg-white border-red-300 hover:border-red-400'\r\n                                                : 'bg-white border-gray-200 hover:border-brand/50'\r\n                                            }`}\r\n                                    >\r\n                                        <Icon size={20} className={orderType === key ? 'text-brand-dark' : 'text-gray-600'} />\r\n                                        <span className={`text-xs font-semibold ${orderType === key ? 'text-brand-dark' : 'text-gray-700'}`}>{label}</span>\r\n                                    </button>\r\n                                ))}\r\n                            </div>\r\n                        </div>\r\n\r\n                        {/* Table Number (for dine-in) */}\r\n                        {orderType === 'dine-in' && (\r\n                            <div>\r\n                                <label htmlFor=\"paymentselection-field-2\" className=\"text-sm font-semibold text-gray-700 mb-2 block\">\r\n                                    Table Number <span className=\"text-red-500\">*</span>\r\n                                </label>\r\n                                <input id=\"paymentselection-field-2\"\r\n                                    type=\"text\"\r\n                                    placeholder=\"Enter table number\"\r\n                                    value={tableNumber}\r\n                                    onChange={(e) => { setTableNumber(e.target.value); setErrors(prev => ({ ...prev, tableNumber: '' })); }}\r\n                                    className={`w-full px-4 py-3 border rounded-xl text-base outline-none transition font-[inherit] ${errors.tableNumber ? 'border-red-400 focus:border-red-500 focus:ring-2 focus:ring-red-200' : 'border-gray-200 focus:border-brand focus:ring-2 focus:ring-brand/20'}`}\r\n                                />\r\n                            </div>\r\n                        )}\r\n\r\n                        {/* Delivery Address (for delivery) */}\r\n                        {orderType === 'delivery' && (\r\n                            <div>\r\n                                <label htmlFor=\"paymentselection-field-3\" className=\"text-sm font-semibold text-gray-700 mb-2 block\">\r\n                                    Delivery Address <span className=\"text-red-500\">*</span>\r\n                                </label>\r\n                                <textarea id=\"paymentselection-field-3\"\r\n                                    placeholder=\"Enter delivery address\"\r\n                                    value={deliveryAddress}\r\n                                    onChange={(e) => { setDeliveryAddress(e.target.value); setErrors(prev => ({ ...prev, deliveryAddress: '' })); }}\r\n                                    rows={2}\r\n                                    className={`w-full px-4 py-3 border rounded-xl text-base outline-none transition font-[inherit] resize-none ${errors.deliveryAddress ? 'border-red-400 focus:border-red-500 focus:ring-2 focus:ring-red-200' : 'border-gray-200 focus:border-brand focus:ring-2 focus:ring-brand/20'}`}\r\n                                />\r\n                            </div>\r\n                        )}\r\n\r\n                        {/* Notes (optional) */}\r\n                        <div>\r\n                            <label htmlFor=\"paymentselection-field-4\" className=\"text-sm font-semibold text-gray-700 mb-2 block\">\r\n                                Notes <span className=\"text-gray-400 font-normal\">(optional)</span>\r\n                            </label>\r\n                            <textarea id=\"paymentselection-field-4\"\r\n                                placeholder=\"Any special instructions...\"\r\n                                value={notes}\r\n                                onChange={(e) => setNotes(e.target.value)}\r\n                                rows={2}\r\n                                className=\"w-full px-4 py-3 border border-gray-200 rounded-xl text-base outline-none focus:border-brand focus:ring-2 focus:ring-brand/20 transition font-[inherit] resize-none min-h-24\"\r\n                            />\r\n                        </div>\r\n                    </div>\r\n\r\n                    {/* Right Column - Payment & Summary */}\r\n                    <div className=\"space-y-4\">\r\n                        {/* Payment Section Header */}\r\n                        <div className=\"border-b-2 border-brand pb-2\">\r\n                            <h2 className=\"text-lg font-bold text-gray-900 flex items-center gap-2\">\r\n                                <Banknote size={20} className=\"text-brand\" />\r\n                                Payment & Discounts\r\n                            </h2>\r\n                        </div>\r\n\r\n                        {/* Payment Methods Card */}\r\n                        <div className=\"bg-white border-2 border-gray-100 rounded-xl p-3\">\r\n                            <h3 className=\"text-xs font-semibold text-gray-600 mb-2 uppercase tracking-wide\">Payment Method</h3>\r\n                            <div className=\"flex flex-col gap-2\">\r\n                                {methods.map(({ key, label, icon: Icon, enabled }) => (\r\n                                    <button\r\n                                        key={key}\r\n                                        onClick={() => enabled && setPaymentMethod(key)}\r\n                                        disabled={!enabled}\r\n                                        className={`flex items-center gap-3 p-3 rounded-lg border-2 transition font-[inherit] ${paymentMethod === key\r\n                                            ? 'bg-brand border-brand'\r\n                                            : 'bg-white border-gray-200 hover:border-brand/50'\r\n                                            } ${!enabled ? 'opacity-50 cursor-not-allowed' : 'cursor-pointer'}`}\r\n                                    >\r\n                                        <Icon size={20} className={paymentMethod === key ? 'text-brand-dark' : 'text-brand'} />\r\n                                        <span className={`flex-1 text-left text-sm font-semibold ${paymentMethod === key ? 'text-brand-dark' : 'text-gray-900'}`}>\r\n                                            {label} {!enabled && '(Coming Soon)'}\r\n                                        </span>\r\n                                        {paymentMethod === key && <Check size={18} className=\"text-brand-dark\" />}\r\n                                    </button>\r\n                                ))}\r\n                            </div>\r\n                        </div>\r\n\r\n                        {/* Discount & Voucher Section - Compact */}\r\n                        <div className=\"space-y-3\">\r\n                            {/* Discount Selection */}\r\n                            <div className=\"bg-white border-2 border-gray-100 rounded-xl p-3\">\r\n                                <h3 className=\"text-xs font-semibold text-gray-600 mb-2 uppercase tracking-wide flex items-center gap-1\">\r\n                                    <Gift size={14} className=\"text-emerald-600\" />\r\n                                    Discount\r\n                                </h3>\r\n                                {discounts.length > 0 ? (\r\n                                    <div className=\"grid grid-cols-2 gap-2 mb-2\">\r\n                                        {discounts.map((discount) => (\r\n                                            <button\r\n                                                key={discount.id}\r\n                                                onClick={() => setSelectedDiscount(selectedDiscount?.id === discount.id ? null : discount)}\r\n                                                className={`px-2.5 py-2 rounded-lg border-2 transition font-semibold text-xs cursor-pointer ${selectedDiscount?.id === discount.id\r\n                                                    ? 'bg-emerald-100 border-emerald-500 text-emerald-700'\r\n                                                    : 'bg-white border-gray-200 text-gray-700 hover:border-emerald-300'\r\n                                                    }`}\r\n                                            >\r\n                                                {discount.name}\r\n                                                <span className=\"block text-xs font-normal\">{discount.percentage}% off</span>\r\n                                            </button>\r\n                                        ))}\r\n                                    </div>\r\n                                ) : (\r\n                                    <p className=\"text-gray-500 text-xs\">None available</p>\r\n                                )}\r\n                                {selectedDiscount && (\r\n                                    <button\r\n                                        onClick={() => setSelectedDiscount(null)}\r\n                                        className=\"w-full px-2 py-1.5 text-xs text-red-600 border border-red-200 rounded hover:bg-red-50 transition cursor-pointer\"\r\n                                    >\r\n                                        Clear\r\n                                    </button>\r\n                                )}\r\n                            </div>\r\n\r\n                            {/* Voucher Code */}\r\n                            <div className=\"bg-white border-2 border-gray-100 rounded-xl p-3\">\r\n                                <h3 className=\"text-xs font-semibold text-gray-600 mb-2 uppercase tracking-wide flex items-center gap-1\">\r\n                                    <Gift size={14} className=\"text-blue-600\" />\r\n                                    Voucher\r\n                                </h3>\r\n                                <div className=\"flex gap-2\">\r\n                                    <input\r\n                                        type=\"text\"\r\n                                        placeholder=\"Code\"\r\n                                        value={voucherCode}\r\n                                        onChange={(e) => setVoucherCode(e.target.value.toUpperCase())}\r\n                                        className={`flex-1 px-3 py-2 border rounded-lg text-sm outline-none transition font-mono ${appliedVoucher ? 'border-emerald-300 focus:border-emerald-400 focus:ring-2 focus:ring-emerald-200' :\r\n                                            voucherError ? 'border-red-400 focus:border-red-500 focus:ring-2 focus:ring-red-200' :\r\n                                                'border-gray-200 focus:border-brand focus:ring-2 focus:ring-brand/20'\r\n                                            }`}\r\n                                    />\r\n                                    <button\r\n                                        onClick={validateVoucher}\r\n                                        className=\"px-3 py-2 bg-brand text-brand-dark rounded-lg font-semibold text-sm hover:shadow-md transition cursor-pointer\"\r\n                                    >\r\n                                        Apply\r\n                                    </button>\r\n                                </div>\r\n                                {voucherError && <p className=\"text-red-500 text-xs mt-1\">{voucherError}</p>}\r\n                                {appliedVoucher && <p className=\"text-emerald-600 text-xs mt-1\">✓ -{`₱${Number(appliedVoucher.amount).toFixed(2)}`}</p>}\r\n                            </div>\r\n                        </div>\r\n\r\n                        {/* Summary Card - Compact */}\r\n                        <div className=\"bg-gradient-to-br from-gray-900 to-gray-800 rounded-xl p-4 text-white border-2 border-brand\">\r\n                            <h3 className=\"text-xs font-semibold text-gray-300 mb-3 uppercase tracking-widest\">Summary</h3>\r\n                            <div className=\"space-y-1.5\">\r\n                                <div className=\"flex justify-between text-sm\">\r\n                                    <span className=\"text-gray-300\">Subtotal</span>\r\n                                    <span className=\"font-semibold\">₱{subtotal.toFixed(2)}</span>\r\n                                </div>\r\n                                {discountAmount > 0 && (\r\n                                    <div className=\"flex justify-between text-sm\">\r\n                                        <span className=\"text-gray-300\">Discount</span>\r\n                                        <span className=\"font-semibold text-emerald-400\">-₱{discountAmount.toFixed(2)}</span>\r\n                                    </div>\r\n                                )}\r\n                                {appliedVoucher && (\r\n                                    <div className=\"flex justify-between text-sm\">\r\n                                        <span className=\"text-gray-300\">Voucher</span>\r\n                                        <span className=\"font-semibold text-emerald-400\">-₱{Number(appliedVoucher.amount).toFixed(2)}</span>\r\n                                    </div>\r\n                                )}\r\n                                <div className=\"flex justify-between pt-2 border-t border-gray-700\">\r\n                                    <span className=\"font-semibold\">Total</span>\r\n                                    <span className=\"text-xl font-bold text-brand\">₱{finalTotal.toFixed(2)}</span>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n\r\n                        {Object.keys(errors).some(k => errors[k]) && (\r\n                            <p className=\"text-red-500 text-xs text-center bg-red-50 border border-red-200 rounded-lg p-2\">⚠️ Fill all required fields</p>\r\n                        )}\r\n\r\n                        <button\r\n                            onClick={handleProceed}\r\n                            className=\"w-full py-3 bg-gradient-to-r from-brand to-brand/80 text-brand-dark rounded-xl font-bold cursor-pointer hover:shadow-xl hover:shadow-brand/30 transition-all active:scale-95 text-base\"\r\n                        >\r\n                            ✓ Proceed to Payment\r\n                        </button>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\ASUS\\Desktop\\Japz\\japz-web\\src\\pages\\cashier\\Profile.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\ASUS\\Desktop\\Japz\\japz-web\\src\\pages\\cashier\\Receipt.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":10,"column":28,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":10,"endColumn":31,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[403,406],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[403,406],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":57,"column":40,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":57,"endColumn":43,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3262,3265],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[3262,3265],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useLocation, useNavigate } from 'react-router-dom';\r\nimport { CheckCircle } from 'lucide-react';\r\n\r\nexport default function Receipt() {\r\n    const navigate = useNavigate();\r\n    const location = useLocation();\r\n    const {\r\n        orderNumber, total, subtotal, discount, amountReceived, change,\r\n        items, method, customerName, orderType, tableNumber, cashier\r\n    } = (location.state as any) || {};\r\n\r\n    if (!orderNumber) return <div className=\"flex flex-col items-center justify-center h-full text-gray-500 gap-2 py-8\"><h1 className=\"text-xl font-semibold text-gray-900\">No receipt to display</h1><p>View previous orders in order history.</p><button className=\"mt-4 px-5 py-3 bg-brand text-brand-dark rounded-md font-semibold\" onClick={() => navigate('/cashier/history')}>View order history</button></div>;\r\n\r\n    const orderDate = new Date();\r\n\r\n    return (\r\n        <div className=\"p-4 md:p-8 flex flex-col items-center min-h-full md:justify-center overflow-y-auto\">\r\n            <div className=\"text-emerald-500 mt-6 md:mt-0 mb-3\"><CheckCircle size={56} /></div>\r\n            <h1 className=\"text-2xl font-bold mb-1\">Payment Successful!</h1>\r\n            <p className=\"text-gray-500 mb-6\">Order #{orderNumber}</p>\r\n\r\n            {/* Receipt Card */}\r\n            <div className=\"w-full max-w-md mx-auto bg-white border-2 border-dashed border-gray-300 rounded-xl p-5 shadow-sm\">\r\n                {/* Header */}\r\n                <div className=\"text-center mb-4\">\r\n                    <img src=\"/logo.jpg\" alt=\"JAPZ\" className=\"w-20 h-20 mx-auto rounded-lg mb-2\" />\r\n                    <h2 className=\"text-xl font-bold\">JAPZ GRILL</h2>\r\n                    <p className=\"text-sm font-semibold text-gray-700\">Burger & Bistro</p>\r\n                    <p className=\"text-xs text-gray-500 mt-2\">Quezon St., Bagumbayan I, Bongabong, Philippines</p>\r\n                    <p className=\"text-xs text-gray-500\">0966 359 9235</p>\r\n                    <p className=\"text-xs text-gray-500\">japzgrillburgerandbistro@gmail.com</p>\r\n                    <p className=\"text-xs text-gray-600 mt-2\">Cashier: {cashier || '—'}</p>\r\n                </div>\r\n\r\n                <div className=\"border-t border-b border-black py-2 mb-3\" />\r\n\r\n                {/* Order Details */}\r\n                <div className=\"text-xs text-gray-600 mb-3 space-y-1\">\r\n                    <div className=\"flex justify-between\">\r\n                        <span>Order #: {orderNumber}</span>\r\n                        <span>POS: POS 1</span>\r\n                    </div>\r\n                    {customerName && <p>Customer: {customerName}</p>}\r\n                    {orderType && (\r\n                        <p>\r\n                            Order Type: {orderType === 'dine-in' ? '🍽️ Dine-in' : orderType === 'take-out' ? '📦 Take-out' : '🚚 Delivery'}\r\n                            {tableNumber && ` (Table ${tableNumber})`}\r\n                        </p>\r\n                    )}\r\n                    <p>{orderDate.toLocaleDateString()} {orderDate.toLocaleTimeString()}</p>\r\n                </div>\r\n\r\n                <div className=\"border-t border-b border-black py-2 mb-3\" />\r\n\r\n                {/* Items */}\r\n                <div className=\"mb-3\">\r\n                    {items?.map((item: any, idx: number) => (\r\n                        <div key={idx} className=\"mb-2\">\r\n                            <div className=\"flex justify-between text-sm\">\r\n                                <span className=\"font-semibold flex-1\">{item.name}</span>\r\n                                <span className=\"font-semibold\">₱{((item.itemPrice || item.price) * item.quantity).toFixed(2)}</span>\r\n                            </div>\r\n                            <p className=\"text-xs text-gray-500\">\r\n                                {item.quantity} x ₱{(item.itemPrice || item.price).toFixed(2)}\r\n                                {item.selectedSize && ` • ${item.selectedSize}`}\r\n                                {item.selectedFlavor && ` • ${item.selectedFlavor}`}\r\n                            </p>\r\n                        </div>\r\n                    ))}\r\n                </div>\r\n\r\n                <div className=\"border-t border-b border-black py-2 mb-3\" />\r\n\r\n                {/* Totals */}\r\n                <div className=\"space-y-1.5\">\r\n                    <div className=\"flex justify-between text-sm\">\r\n                        <span className=\"text-gray-600\">Subtotal:</span>\r\n                        <span>₱{Number(subtotal || total).toFixed(2)}</span>\r\n                    </div>\r\n                    {Number(discount) > 0 && (\r\n                        <div className=\"flex justify-between text-sm\">\r\n                            <span className=\"text-gray-600\">Discount:</span>\r\n                            <span className=\"text-emerald-500\">-₱{Number(discount).toFixed(2)}</span>\r\n                        </div>\r\n                    )}\r\n                    <div className=\"flex justify-between font-bold text-lg pt-2 border-t border-gray-200\">\r\n                        <span>Total:</span>\r\n                        <span>₱{Number(total).toFixed(2)}</span>\r\n                    </div>\r\n                    <div className=\"flex justify-between text-sm\">\r\n                        <span className=\"text-gray-600\">Paid ({method}):</span>\r\n                        <span>₱{Number(amountReceived).toFixed(2)}</span>\r\n                    </div>\r\n                    <div className=\"flex justify-between font-semibold text-emerald-500 text-lg\">\r\n                        <span>Change:</span>\r\n                        <span>₱{Number(change).toFixed(2)}</span>\r\n                    </div>\r\n                </div>\r\n\r\n                {/* Footer */}\r\n                <div className=\"border-t border-dashed border-gray-300 mt-4 pt-4 text-center\">\r\n                    <p className=\"text-sm font-semibold\">Thank you for dining with us!</p>\r\n                    <p className=\"text-xs text-gray-500 mt-1\">Please come again</p>\r\n                </div>\r\n\r\n\r\n            </div>\r\n\r\n            <button className=\"w-full max-w-md py-4 mt-6 rounded-xl bg-brand font-semibold text-brand-dark text-base hover:shadow-md hover:shadow-yellow-300/40 active:scale-[0.97] transition-all\"\r\n                onClick={() => navigate('/cashier/pos', { replace: true })}>\r\n                New Order\r\n            </button>\r\n        </div>\r\n    );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\ASUS\\Desktop\\Japz\\japz-web\\src\\pages\\kitchen\\Completed.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchOrders'. Either include it or remove the dependency array.","line":53,"column":8,"nodeType":"ArrayExpression","endLine":53,"endColumn":14,"suggestions":[{"desc":"Update the dependencies array to be: [fetchOrders, user]","fix":{"range":[1595,1601],"text":"[fetchOrders, user]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect } from 'react';\r\nimport { Clock, ChevronDown, ChevronUp, CheckCircle2, UtensilsCrossed, StickyNote, Calendar, MapPin } from 'lucide-react';\r\nimport { ordersAPI } from '../../services/api';\r\nimport { useAuth } from '../../hooks/useAuth';\r\n\r\ninterface CompletedOrder {\r\n    id: number;\r\n    orderNumber: string;\r\n    status: string;\r\n    createdAt: string;\r\n    completedAt?: string;\r\n    customerName?: string;\r\n    orderType?: string;\r\n    tableNumber?: string;\r\n    deliveryAddress?: string;\r\n    notes?: string;\r\n    items?: {\r\n        name: string;\r\n        quantity: number;\r\n        modifiers?: {\r\n            size?: string;\r\n            flavors?: string[];\r\n            temperature?: string;\r\n        };\r\n    }[];\r\n}\r\n\r\nexport default function KitchenCompleted() {\r\n    const { user } = useAuth();\r\n    const [orders, setOrders] = useState<CompletedOrder[]>([]);\r\n    const [loading, setLoading] = useState(true);\r\n    const [expanded, setExpanded] = useState<number | null>(null);\r\n\r\n    const fetchOrders = async () => {\r\n        try {\r\n            const res = await ordersAPI.getCompletedByCategories({\r\n                assignedCategories: user?.assignedCategories || []\r\n            });\r\n            setOrders(res.data?.orders || []);\r\n        } catch (e) {\r\n            console.error(e);\r\n        } finally {\r\n            setLoading(false);\r\n        }\r\n    };\r\n\r\n    useEffect(() => {\r\n        if (user) {\r\n            fetchOrders();\r\n            const id = setInterval(fetchOrders, 10000);\r\n            return () => clearInterval(id);\r\n        }\r\n    }, [user]);\r\n\r\n    const getPhilippineTime = (timestamp?: string) => {\r\n        try {\r\n            const date = timestamp ? new Date(timestamp) : new Date();\r\n            return date.toLocaleString('en-PH', {\r\n                timeZone: 'Asia/Manila',\r\n                month: 'short',\r\n                day: '2-digit',\r\n                hour: '2-digit',\r\n                minute: '2-digit',\r\n                hour12: true,\r\n            });\r\n        } catch {\r\n            return 'N/A';\r\n        }\r\n    };\r\n\r\n    const getTotalWaitDuration = (createdAt?: string, completedAt?: string) => {\r\n        try {\r\n            if (!createdAt) return 'N/A';\r\n            const created = new Date(createdAt);\r\n            const completed = completedAt ? new Date(completedAt) : new Date();\r\n            const diffMs = completed.getTime() - created.getTime();\r\n            const totalMinutes = Math.floor(diffMs / 60000);\r\n\r\n            if (totalMinutes < 1) {\r\n                const seconds = Math.floor(diffMs / 1000);\r\n                return `${seconds}s`;\r\n            } else if (totalMinutes < 60) {\r\n                return `${totalMinutes}m`;\r\n            } else {\r\n                const hours = Math.floor(totalMinutes / 60);\r\n                const mins = totalMinutes % 60;\r\n                return `${hours}h ${mins}m`;\r\n            }\r\n        } catch {\r\n            return 'N/A';\r\n        }\r\n    };\r\n\r\n    if (loading) {\r\n        return (\r\n            <div className=\"flex items-center justify-center h-full\">\r\n                <div className=\"spinner\" />\r\n            </div>\r\n        );\r\n    }\r\n    // Show newest completed orders first on this page\r\n    const sortedOrders = [...orders].sort((a, b) => {\r\n        const aTime = a.completedAt ? new Date(a.completedAt).getTime() : new Date(a.createdAt).getTime();\r\n        const bTime = b.completedAt ? new Date(b.completedAt).getTime() : new Date(b.createdAt).getTime();\r\n        return bTime - aTime;\r\n    });\r\n\r\n    return (\r\n        <div className=\"app-page kitchen-page\">\r\n            {/* Header */}\r\n            <div className=\"mb-6\">\r\n                <h1 className=\"text-2xl font-bold text-gray-800\">Completed Orders</h1>\r\n                <p className=\"text-gray-500 text-sm mt-1\">View orders completed today</p>\r\n            </div>\r\n\r\n            {/* Stats Card */}\r\n                <div className=\"bg-green-50 border-l-4 border-green-500 rounded-lg p-4 mb-6\">\r\n                <div className=\"flex items-center gap-3\">\r\n                    <div className=\"bg-green-500 p-2 rounded-lg\">\r\n                        <CheckCircle2 size={24} className=\"text-white\" />\r\n                    </div>\r\n                    <div>\r\n                            <p className=\"text-2xl font-bold text-green-700\">{sortedOrders.length}</p>\r\n                        <p className=\"text-sm text-green-600\">Orders Completed Today</p>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            {sortedOrders.length === 0 ? (\r\n                <div className=\"flex flex-col items-center justify-center text-gray-500 gap-3 py-16 bg-gray-50 rounded-xl\">\r\n                    <Calendar size={48} className=\"text-gray-300\" />\r\n                    <p className=\"text-lg font-medium\">No completed orders today</p>\r\n                    <p className=\"text-sm\">Completed orders will appear here</p>\r\n                </div>\r\n            ) : (\r\n                <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\r\n                    {sortedOrders.map((order) => (\r\n                        <div\r\n                            key={order.id}\r\n                            className=\"bg-white border border-gray-200 rounded-xl p-4 shadow-sm cursor-pointer transition-all hover:shadow-md\"\r\n                            onClick={() => setExpanded(expanded === order.id ? null : order.id)}\r\n                        >\r\n                            {/* Order Header */}\r\n                            <div className=\"flex justify-between items-start mb-3\">\r\n                                <div>\r\n                                    <span className=\"font-bold text-lg\">Order #{order.orderNumber}</span>\r\n                                    <div className=\"flex items-center gap-1.5 mt-1 text-green-600\">\r\n                                        <Clock size={14} />\r\n                                        <span className=\"text-sm font-medium\">\r\n                                            {getTotalWaitDuration(order.createdAt, order.completedAt)} total\r\n                                        </span>\r\n                                    </div>\r\n                                </div>\r\n                                <div className=\"flex items-center gap-2\">\r\n                                    \r\n                                    {expanded === order.id ? (\r\n                                        <ChevronUp size={18} className=\"text-gray-400\" />\r\n                                    ) : (\r\n                                        <ChevronDown size={18} className=\"text-gray-400\" />\r\n                                    )}\r\n                                </div>\r\n                            </div>\r\n\r\n                            {/* Compact info: only show on card header */}\r\n                            <div className=\"mb-3\">\r\n                                <div className=\"flex items-center justify-start gap-3\">\r\n                                    {order.customerName ? (\r\n                                        <span className=\"font-medium\">{order.customerName}</span>\r\n                                    ) : (\r\n                                        <span className=\"text-sm text-gray-500\">Guest</span>\r\n                                    )}\r\n                                    {order.orderType && (\r\n                                        <span className=\"text-xs px-2 py-0.5 bg-gray-100 rounded capitalize\">{order.orderType.replace('-', ' ')}</span>\r\n                                    )}\r\n                                </div>\r\n                            </div>\r\n\r\n                            {/* Expanded details (customer info, timestamps, items) */}\r\n                            {expanded === order.id && (\r\n                                <div className=\"mt-3 pt-3 border-t border-gray-100 space-y-3\">\r\n                                    <div className=\"bg-gray-50 rounded-lg p-3 space-y-2\">\r\n                                        \r\n                                        {order.orderType && (\r\n                                            <div className=\"flex items-center gap-2 text-sm\">\r\n                                                <UtensilsCrossed size={14} className=\"text-gray-500\" />\r\n                                                <span className=\"capitalize\">{order.orderType.replace('-', ' ')}</span>\r\n                                                {order.orderType === 'dine-in' && order.tableNumber && (\r\n                                                    <span className=\"bg-gray-200 px-2 py-0.5 rounded text-xs font-medium\">\r\n                                                        Table {order.tableNumber}\r\n                                                    </span>\r\n                                                )}\r\n                                            </div>\r\n                                        )}\r\n                                        {order.orderType === 'delivery' && order.deliveryAddress && (\r\n                                            <div className=\"flex items-start gap-2 text-sm\">\r\n                                                <MapPin size={14} className=\"text-red-500 mt-0.5 shrink-0\" />\r\n                                                <span className=\"text-gray-700\">{order.deliveryAddress}</span>\r\n                                            </div>\r\n                                        )}\r\n                                        {order.notes && (\r\n                                            <div className=\"flex items-start gap-2 text-sm\">\r\n                                                <StickyNote size={14} className=\"text-gray-500 mt-0.5\" />\r\n                                                <span className=\"text-gray-600 italic\">{order.notes}</span>\r\n                                            </div>\r\n                                        )}\r\n                                    </div>\r\n\r\n                                    <div className=\"bg-green-50 rounded-lg px-3 py-2.5\">\r\n                                        <div className=\"flex justify-between text-xs text-gray-600\">\r\n                                            <div className=\"flex items-center gap-1\">\r\n                                                <Clock size={12} />\r\n                                                <span>Ordered: {getPhilippineTime(order.createdAt)}</span>\r\n                                            </div>\r\n                                            <div className=\"flex items-center gap-1\">\r\n                                                <CheckCircle2 size={12} />\r\n                                                <span>Completed: {getPhilippineTime(order.completedAt)}</span>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n\r\n                                    <div>\r\n                                        <p className=\"text-xs font-semibold text-gray-500 uppercase mb-2\">Order Items</p>\r\n                                        {order.items?.map((item, idx) => (\r\n                                            <div key={idx} className=\"text-sm py-1.5 pl-2 border-l-2 border-green-300\">\r\n                                                <span className=\"font-medium\">{item.name}</span>\r\n                                                {item.modifiers?.size && (\r\n                                                    <span className=\"text-gray-500 ml-1\">({item.modifiers.size})</span>\r\n                                                )}\r\n                                                {item.modifiers?.temperature && (\r\n                                                    <span className=\"text-gray-500 ml-1\">• {item.modifiers.temperature}</span>\r\n                                                )}\r\n                                                <span className=\"text-gray-600 ml-2\">×{item.quantity}</span>\r\n                                                {item.modifiers?.flavors && item.modifiers.flavors.length > 0 && (\r\n                                                    <p className=\"text-xs text-gray-500 mt-0.5\">\r\n                                                        Flavors: {item.modifiers.flavors.join(', ')}\r\n                                                    </p>\r\n                                                )}\r\n                                            </div>\r\n                                        ))}\r\n                                    </div>\r\n                                </div>\r\n                            )}\r\n                        </div>\r\n                    ))}\r\n                </div>\r\n            )}\r\n        </div>\r\n    );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\ASUS\\Desktop\\Japz\\japz-web\\src\\pages\\kitchen\\Incoming.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":37,"column":35,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":37,"endColumn":38,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1239,1242],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1239,1242],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":79,"column":64,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":79,"endColumn":67,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3144,3147],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[3144,3147],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'e' is defined but never used.","line":87,"column":18,"nodeType":"Identifier","messageId":"unusedVar","endLine":87,"endColumn":19},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":92,"column":46,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":92,"endColumn":49,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3664,3667],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[3664,3667],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":92,"column":83,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":92,"endColumn":86,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3701,3704],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[3701,3704],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":101,"column":31,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":101,"endColumn":34,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[4144,4147],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[4144,4147],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":102,"column":33,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":102,"endColumn":36,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[4250,4253],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[4250,4253],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'e' is defined but never used.","line":113,"column":56,"nodeType":"Identifier","messageId":"unusedVar","endLine":113,"endColumn":57},{"ruleId":"no-empty","severity":2,"message":"Empty block statement.","line":113,"column":59,"nodeType":"BlockStatement","messageId":"unexpected","endLine":113,"endColumn":62,"suggestions":[{"messageId":"suggestComment","data":{"type":"block"},"fix":{"range":[4651,4652],"text":" /* empty */ "},"desc":"Add comment inside empty block statement."}]},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'fetchOrders'. Either include it or remove the dependency array.","line":123,"column":8,"nodeType":"ArrayExpression","endLine":123,"endColumn":14,"suggestions":[{"desc":"Update the dependencies array to be: [fetchOrders, user]","fix":{"range":[4890,4896],"text":"[fetchOrders, user]"}}]}],"suppressedMessages":[],"errorCount":9,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useFeedback } from '../../components/FeedbackProvider';\r\nimport { useState, useEffect, useRef } from 'react';\r\nimport { Clock, ChefHat, CheckCircle, UtensilsCrossed, User, StickyNote, Play, Check, MapPin, Speaker, Mic } from 'lucide-react';\r\nimport { ordersAPI } from '../../services/api';\r\nimport { useAuth } from '../../hooks/useAuth';\r\nimport { isAxiosError } from 'axios';\r\n\r\ntype StatusFilter = 'pending' | 'preparing' | 'ready';\r\n\r\ninterface KitchenOrder {\r\n    id: number;\r\n    orderNumber: string;\r\n    status: string;\r\n    createdAt: string;\r\n    customerName?: string;\r\n    orderType?: string;\r\n    tableNumber?: string;\r\n    deliveryAddress?: string;\r\n    notes?: string;\r\n    items?: {\r\n        name: string;\r\n        quantity: number;\r\n        modifiers?: {\r\n            size?: string;\r\n            flavors?: string[];\r\n            temperature?: string;\r\n        };\r\n    }[];\r\n}\r\n\r\nexport default function KitchenIncoming() {\r\n    const { notify } = useFeedback();\r\n    const { user } = useAuth();\r\n    const [speakerEnabled, setSpeakerEnabled] = useState(true);\r\n    const [inventoryError, setInventoryError] = useState('');\r\n    const [listening, setListening] = useState(false);\r\n    const recognitionRef = useRef<any>(null);\r\n    const prevOrderIdsRef = useRef<number[]>([]);\r\n    const [orders, setOrders] = useState<KitchenOrder[]>([]);\r\n    const [loading, setLoading] = useState(true);\r\n    const [statusFilter, setStatusFilter] = useState<StatusFilter>('pending');\r\n    const [processingOrders, setProcessingOrders] = useState<Set<number>>(new Set());\r\n\r\n    const fetchOrders = async () => {\r\n        try { \r\n            const res = await ordersAPI.getIncomingByCategories({ \r\n                assignedCategories: user?.assignedCategories || [] \r\n            }); \r\n            const newOrders: KitchenOrder[] = res.data?.orders || [];\r\n            // Announce newly arrived orders when speaker is enabled\r\n            if (speakerEnabled && prevOrderIdsRef.current && prevOrderIdsRef.current.length) {\r\n                const prevSet = new Set(prevOrderIdsRef.current);\r\n                const added = newOrders.filter(o => !prevSet.has(o.id));\r\n                if (added.length > 0) {\r\n                    added.forEach(o => announceOrder(o));\r\n                }\r\n            }\r\n            prevOrderIdsRef.current.length = 0;\r\n            newOrders.forEach(o => prevOrderIdsRef.current.push(o.id));\r\n            setOrders(newOrders);\r\n        }\r\n        catch (e) { console.error(e); }\r\n        finally { setLoading(false); }\r\n    };\r\n\r\n    const speakText = (text: string) => {\r\n        try {\r\n            const utter = new SpeechSynthesisUtterance(text);\r\n            speechSynthesis.cancel();\r\n            speechSynthesis.speak(utter);\r\n        } catch (e) { console.error('TTS error', e); }\r\n    };\r\n\r\n    const announceOrder = (order: KitchenOrder) => {\r\n        const message = `New order ${order.orderNumber}. Please check the incoming orders.`;\r\n        // play short beep then speak\r\n        try {\r\n            // simple beep using WebAudio\r\n            const ctx = new (window.AudioContext || (window as any).webkitAudioContext)();\r\n            const o = ctx.createOscillator();\r\n            const g = ctx.createGain();\r\n            o.type = 'sine'; o.frequency.value = 880;\r\n            g.gain.value = 0.05;\r\n            o.connect(g); g.connect(ctx.destination);\r\n            o.start();\r\n            setTimeout(() => { o.stop(); ctx.close(); }, 150);\r\n        } catch (e) { /* ignore audio errors */ }\r\n        speakText(message);\r\n    };\r\n\r\n    const startListening = () => {\r\n        const SpeechRecognition = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;\r\n        if (!SpeechRecognition) return notify('Speech recognition not supported in this browser');\r\n        try {\r\n            const rec = new SpeechRecognition();\r\n            rec.lang = 'en-US';\r\n            rec.interimResults = false;\r\n            rec.maxAlternatives = 1;\r\n            rec.onstart = () => setListening(true);\r\n            rec.onend = () => setListening(false);\r\n            rec.onerror = (e: any) => { console.error('Recognition error', e); setListening(false); };\r\n            rec.onresult = (ev: any) => {\r\n                const text = ev.results[0][0].transcript;\r\n                // speak out the recognized text as a broadcast\r\n                speakText(text);\r\n            };\r\n            rec.start();\r\n            recognitionRef.current = rec;\r\n        } catch (e) { console.error(e); }\r\n    };\r\n\r\n    const stopListening = () => {\r\n        try { recognitionRef.current?.stop(); } catch (e) { }\r\n        setListening(false);\r\n    };\r\n\r\n    useEffect(() => { \r\n        if (user) {\r\n            fetchOrders(); \r\n            const id = setInterval(fetchOrders, 3000); \r\n            return () => clearInterval(id); \r\n        }\r\n    }, [user]);\r\n\r\n    const updateOrderStatus = async (orderId: number, newStatus: string) => {\r\n        if (processingOrders.has(orderId)) return;\r\n        \r\n        setProcessingOrders(prev => new Set(prev).add(orderId));\r\n        try {\r\n            setInventoryError('');\r\n            await ordersAPI.updateOrderStatus(orderId, newStatus);\r\n            await fetchOrders();\r\n        } catch (error) {\r\n            const message = isAxiosError<{ error?: string }>(error) ? error.response?.data?.error : undefined;\r\n            setInventoryError(message || 'Order status could not be changed. Try again.');\r\n        } finally {\r\n            setProcessingOrders(prev => {\r\n                const next = new Set(prev);\r\n                next.delete(orderId);\r\n                return next;\r\n            });\r\n        }\r\n    };\r\n\r\n    const getWaitTime = (createdAt: string) => {\r\n        const created = new Date(createdAt);\r\n        const now = new Date();\r\n        const diffMs = now.getTime() - created.getTime();\r\n        const minutes = Math.floor(diffMs / 60000);\r\n        \r\n        if (minutes < 1) return 'Just now';\r\n        if (minutes < 60) return `${minutes}m`;\r\n        const hours = Math.floor(minutes / 60);\r\n        const mins = minutes % 60;\r\n        return `${hours}h ${mins}m`;\r\n    };\r\n\r\n    // Ensure orders are explicitly sorted FIFO (oldest first) on the client\r\n    const sortedOrders = [...orders].sort((a, b) => new Date(a.createdAt).getTime() - new Date(b.createdAt).getTime());\r\n\r\n    // Filter orders by status from the sorted list\r\n    const filteredOrders = sortedOrders.filter(order => {\r\n        if (statusFilter === 'pending') return order.status === 'pending';\r\n        if (statusFilter === 'preparing') return order.status === 'preparing';\r\n        if (statusFilter === 'ready') return order.status === 'ready';\r\n        return false;\r\n    });\r\n\r\n    // Count orders by status (from sortedOrders for consistency)\r\n    const pendingCount = sortedOrders.filter(o => o.status === 'pending').length;\r\n    const preparingCount = sortedOrders.filter(o => o.status === 'preparing').length;\r\n    const readyCount = sortedOrders.filter(o => o.status === 'ready').length;\r\n\r\n    const getStatusConfig = (status: StatusFilter) => {\r\n        switch (status) {\r\n            case 'pending':\r\n                return {\r\n                    bg: 'bg-yellow-50',\r\n                    border: 'border-yellow-400',\r\n                    badge: 'bg-yellow-500',\r\n                    icon: Clock,\r\n                    label: 'PENDING'\r\n                };\r\n            case 'preparing':\r\n                return {\r\n                    bg: 'bg-blue-50',\r\n                    border: 'border-blue-400',\r\n                    badge: 'bg-blue-500',\r\n                    icon: ChefHat,\r\n                    label: 'PREPARING'\r\n                };\r\n            case 'ready':\r\n                return {\r\n                    bg: 'bg-green-50',\r\n                    border: 'border-green-400',\r\n                    badge: 'bg-green-500',\r\n                    icon: CheckCircle,\r\n                    label: 'READY'\r\n                };\r\n        }\r\n    };\r\n\r\n    const getActionButton = (order: KitchenOrder) => {\r\n        const isProcessing = processingOrders.has(order.id);\r\n        \r\n        switch (order.status) {\r\n            case 'pending':\r\n                return (\r\n                    <button\r\n                        onClick={(e) => { e.stopPropagation(); updateOrderStatus(order.id, 'preparing'); }}\r\n                        disabled={isProcessing}\r\n                        className=\"w-full py-3 mt-3 rounded-lg bg-blue-500 hover:bg-blue-600 text-white font-semibold text-[15px] flex items-center justify-center gap-2 transition-all disabled:opacity-50\"\r\n                    >\r\n                        <Play size={18} />\r\n                        {isProcessing ? 'Processing...' : 'Start Preparing'}\r\n                    </button>\r\n                );\r\n            case 'preparing':\r\n                return (\r\n                    <button\r\n                        onClick={(e) => { e.stopPropagation(); updateOrderStatus(order.id, 'ready'); }}\r\n                        disabled={isProcessing}\r\n                        className=\"w-full py-3 mt-3 rounded-lg bg-green-500 hover:bg-green-600 text-white font-semibold text-[15px] flex items-center justify-center gap-2 transition-all disabled:opacity-50\"\r\n                    >\r\n                        <Check size={18} />\r\n                        {isProcessing ? 'Processing...' : 'Mark Ready'}\r\n                    </button>\r\n                );\r\n            case 'ready':\r\n                return (\r\n                    <button\r\n                        onClick={(e) => { e.stopPropagation(); updateOrderStatus(order.id, 'completed'); }}\r\n                        disabled={isProcessing}\r\n                        className=\"w-full py-3 mt-3 rounded-lg bg-gray-600 hover:bg-gray-700 text-white font-semibold text-[15px] flex items-center justify-center gap-2 transition-all disabled:opacity-50\"\r\n                    >\r\n                        <CheckCircle size={18} />\r\n                        {isProcessing ? 'Processing...' : 'Complete Order'}\r\n                    </button>\r\n                );\r\n            default:\r\n                return null;\r\n        }\r\n    };\r\n\r\n    if (loading) {\r\n        return (\r\n            <div className=\"flex items-center justify-center h-full\">\r\n                <div className=\"spinner\" />\r\n            </div>\r\n        );\r\n    }\r\n\r\n    return (\r\n        <div className=\"app-page kitchen-page\">\r\n            {inventoryError && <div role=\"alert\" className=\"p-3 m-3 bg-red-50 border border-red-200 rounded-md text-red-800\">{inventoryError}</div>}\r\n            {/* Header */}\r\n            <div className=\"mb-6 flex flex-wrap items-center justify-between gap-3\">\r\n                <div>\r\n                    <h1 className=\"text-2xl font-bold text-gray-800\">Kitchen Orders</h1>\r\n                    <p className=\"text-gray-500 text-sm mt-1\">Manage incoming orders for your assigned stations</p>\r\n                </div>\r\n                <div className=\"flex items-center gap-3\">\r\n                    <button onClick={() => setSpeakerEnabled(prev => !prev)} title={speakerEnabled ? 'Speaker on' : 'Speaker off'}\r\n                        className={`flex items-center justify-center w-8 h-8 rounded-lg transition cursor-pointer border border-gray-200 ${speakerEnabled ? 'bg-yellow-100 text-yellow-700' : 'hover:bg-gray-100 text-gray-600'}`}>\r\n                        <Speaker size={18} />\r\n                    </button>\r\n                    <button onClick={() => listening ? stopListening() : startListening()} title={listening ? 'Stop listening' : 'Broadcast via mic'}\r\n                        className={`flex items-center justify-center w-8 h-8 rounded-lg transition cursor-pointer border border-gray-200 ${listening ? 'bg-red-100 text-red-600' : 'hover:bg-gray-100 text-gray-600'}`}>\r\n                        <Mic size={18} />\r\n                    </button>\r\n                </div>\r\n            </div>\r\n\r\n            {/* Status Filter Tabs */}\r\n            <div className=\"order-filters flex gap-2 mb-6\" aria-label=\"Order status\">\r\n                <button\r\n                    aria-pressed={statusFilter === 'pending'} onClick={() => setStatusFilter('pending')}\r\n                    className={`flex items-center gap-2 px-4 py-2.5 rounded-lg font-medium transition-all whitespace-nowrap ${\r\n                        statusFilter === 'pending'\r\n                            ? 'bg-brand text-brand-dark'\r\n                            : 'bg-white text-gray-600 hover:bg-gray-100'\r\n                    }`}\r\n                >\r\n                    <Clock size={18} />\r\n                    Pending\r\n                    {pendingCount > 0 && (\r\n                        <span className={`px-2 py-0.5 rounded-full text-xs font-bold ${\r\n                            statusFilter === 'pending' ? 'bg-white text-yellow-600' : 'bg-yellow-500 text-white'\r\n                        }`}>\r\n                            {pendingCount}\r\n                        </span>\r\n                    )}\r\n                </button>\r\n                <button\r\n                    aria-pressed={statusFilter === 'preparing'} onClick={() => setStatusFilter('preparing')}\r\n                    className={`flex items-center gap-2 px-4 py-2.5 rounded-lg font-medium transition-all whitespace-nowrap ${\r\n                        statusFilter === 'preparing'\r\n                            ? 'bg-brand text-brand-dark'\r\n                            : 'bg-white text-gray-600 hover:bg-gray-100'\r\n                    }`}\r\n                >\r\n                    <ChefHat size={18} />\r\n                    Preparing\r\n                    {preparingCount > 0 && (\r\n                        <span className={`px-2 py-0.5 rounded-full text-xs font-bold ${\r\n                            statusFilter === 'preparing' ? 'bg-white text-blue-600' : 'bg-blue-500 text-white'\r\n                        }`}>\r\n                            {preparingCount}\r\n                        </span>\r\n                    )}\r\n                </button>\r\n                <button\r\n                    aria-pressed={statusFilter === 'ready'} onClick={() => setStatusFilter('ready')}\r\n                    className={`flex items-center gap-2 px-4 py-2.5 rounded-lg font-medium transition-all whitespace-nowrap ${\r\n                        statusFilter === 'ready'\r\n                            ? 'bg-brand text-brand-dark'\r\n                            : 'bg-white text-gray-600 hover:bg-gray-100'\r\n                    }`}\r\n                >\r\n                    <CheckCircle size={18} />\r\n                    Ready\r\n                    {readyCount > 0 && (\r\n                        <span className={`px-2 py-0.5 rounded-full text-xs font-bold ${\r\n                            statusFilter === 'ready' ? 'bg-white text-green-600' : 'bg-green-500 text-white'\r\n                        }`}>\r\n                            {readyCount}\r\n                        </span>\r\n                    )}\r\n                </button>\r\n            </div>\r\n\r\n            {/* Orders Grid */}\r\n            {filteredOrders.length === 0 ? (\r\n                <div className=\"flex flex-col items-center justify-center text-gray-500 gap-3 py-16 bg-gray-50 rounded-xl\">\r\n                    <UtensilsCrossed size={48} className=\"text-gray-300\" />\r\n                    <p className=\"text-lg font-medium\">No {statusFilter} orders</p>\r\n                    <p className=\"text-sm\">Orders will appear here when available</p>\r\n                </div>\r\n            ) : (\r\n                <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\r\n                    {filteredOrders.map((order) => {\r\n                        const config = getStatusConfig(order.status as StatusFilter);\r\n                        const StatusIcon = config.icon;\r\n                        \r\n                        return (\r\n                            <div\r\n                                key={order.id}\r\n                                className={`${config.bg} border-2 ${config.border} rounded-xl p-4 transition-all hover:shadow-lg`}\r\n                            >\r\n                                {/* Order Header */}\r\n                                <div className=\"flex justify-between items-start mb-3\">\r\n                                    <div>\r\n                                        <span className=\"font-bold text-lg\">Order #{order.orderNumber}</span>\r\n                                        <div className=\"flex items-center gap-1.5 mt-1 text-gray-600\">\r\n                                            <Clock size={14} />\r\n                                            <span className=\"text-sm font-medium\">{getWaitTime(order.createdAt)}</span>\r\n                                        </div>\r\n                                    </div>\r\n                                    <span className={`${config.badge} text-white px-2.5 py-1 rounded-md text-xs font-bold flex items-center gap-1`}>\r\n                                        <StatusIcon size={12} />\r\n                                        {config.label}\r\n                                    </span>\r\n                                </div>\r\n\r\n                                {/* Customer Info */}\r\n                                <div className=\"bg-white/60 rounded-lg p-3 mb-3 space-y-2\">\r\n                                    {order.customerName && (\r\n                                        <div className=\"flex items-center gap-2 text-sm\">\r\n                                            <User size={14} className=\"text-gray-500\" />\r\n                                            <span className=\"font-medium\">{order.customerName}</span>\r\n                                        </div>\r\n                                    )}\r\n                                    {order.orderType && (\r\n                                        <div className=\"flex items-center gap-2 text-sm\">\r\n                                            <UtensilsCrossed size={14} className=\"text-gray-500\" />\r\n                                            <span className=\"capitalize\">{order.orderType.replace('-', ' ')}</span>\r\n                                            {order.orderType === 'dine-in' && order.tableNumber && (\r\n                                                <span className=\"bg-gray-200 px-2 py-0.5 rounded text-xs font-medium\">\r\n                                                    Table {order.tableNumber}\r\n                                                </span>\r\n                                            )}\r\n                                        </div>\r\n                                    )}\r\n                                    {order.orderType === 'delivery' && order.deliveryAddress && (\r\n                                        <div className=\"flex items-start gap-2 text-sm\">\r\n                                            <MapPin size={14} className=\"text-red-500 mt-0.5 shrink-0\" />\r\n                                            <span className=\"text-gray-700\">{order.deliveryAddress}</span>\r\n                                        </div>\r\n                                    )}\r\n                                    {order.notes && (\r\n                                        <div className=\"flex items-start gap-2 text-sm\">\r\n                                            <StickyNote size={14} className=\"text-gray-500 mt-0.5\" />\r\n                                            <span className=\"text-gray-600 italic\">{order.notes}</span>\r\n                                        </div>\r\n                                    )}\r\n                                </div>\r\n\r\n                                {/* Order Items */}\r\n                                <div className=\"space-y-1.5 mb-2\">\r\n                                    <p className=\"text-xs font-semibold text-gray-500 uppercase\">Items</p>\r\n                                    {order.items?.map((item, idx) => (\r\n                                        <div key={idx} className=\"text-sm py-1 pl-2 border-l-2 border-gray-300\">\r\n                                            <span className=\"font-medium\">{item.name}</span>\r\n                                            {item.modifiers?.size && (\r\n                                                <span className=\"text-gray-500 ml-1\">({item.modifiers.size})</span>\r\n                                            )}\r\n                                            {item.modifiers?.temperature && (\r\n                                                <span className=\"text-gray-500 ml-1\">• {item.modifiers.temperature}</span>\r\n                                            )}\r\n                                            <span className=\"text-gray-600 ml-2\">×{item.quantity}</span>\r\n                                            {item.modifiers?.flavors && item.modifiers.flavors.length > 0 && (\r\n                                                <p className=\"text-xs text-gray-500 mt-0.5\">\r\n                                                    Flavors: {item.modifiers.flavors.join(', ')}\r\n                                                </p>\r\n                                            )}\r\n                                        </div>\r\n                                    ))}\r\n                                </div>\r\n\r\n                                {/* Action Button */}\r\n                                {getActionButton(order)}\r\n                            </div>\r\n                        );\r\n                    })}\r\n                </div>\r\n            )}\r\n        </div>\r\n    );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\ASUS\\Desktop\\Japz\\japz-web\\src\\pages\\kitchen\\Profile.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\ASUS\\Desktop\\Japz\\japz-web\\src\\pages\\public\\Feedback.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":87,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":87,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3130,3133],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[3130,3133],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect } from 'react';\r\nimport { Star, Send, CheckCircle, AlertCircle, XCircle } from 'lucide-react';\r\nimport { feedbackAPI, qrKeyAPI } from '../../services/api';\r\nimport { useSearchParams } from 'react-router-dom';\r\n\r\nexport default function Feedback() {\r\n    const [searchParams] = useSearchParams();\r\n    const qrKey = searchParams.get('key');\r\n\r\n    const [validatingKey, setValidatingKey] = useState(true);\r\n    const [keyValid, setKeyValid] = useState(false);\r\n\r\n    const [orderNumber, setOrderNumber] = useState('');\r\n    const [rating, setRating] = useState<number>(0);\r\n    const [hoverRating, setHoverRating] = useState<number>(0);\r\n    const [comment, setComment] = useState('');\r\n    const [submitting, setSubmitting] = useState(false);\r\n    const [submitted, setSubmitted] = useState(false);\r\n    const [error, setError] = useState('');\r\n\r\n    // Generate date prefix as MM-DD\r\n    const getDatePrefix = () => {\r\n        const now = new Date();\r\n        const mm = String(now.getMonth() + 1).padStart(2, '0');\r\n        const dd = String(now.getDate()).padStart(2, '0');\r\n        return `${mm}-${dd}`;\r\n    };\r\n    const datePrefix = getDatePrefix();\r\n    const fullOrderNumber = `${datePrefix}-ORD-${orderNumber.trim()}`;\r\n\r\n    // Validate the QR key on mount\r\n    useEffect(() => {\r\n        const validateKey = async () => {\r\n            if (!qrKey) {\r\n                setKeyValid(false);\r\n                setValidatingKey(false);\r\n                return;\r\n            }\r\n            try {\r\n                const res = await qrKeyAPI.validate(qrKey);\r\n                setKeyValid(res.data.valid);\r\n            } catch {\r\n                setKeyValid(false);\r\n            } finally {\r\n                setValidatingKey(false);\r\n            }\r\n        };\r\n        validateKey();\r\n    }, [qrKey]);\r\n\r\n    useEffect(() => {\r\n        // Check if feedback already submitted for this order (stored in localStorage)\r\n        if (orderNumber) {\r\n            const submittedOrders = JSON.parse(localStorage.getItem('feedbackSubmitted') || '[]');\r\n            if (submittedOrders.includes(fullOrderNumber)) {\r\n                setSubmitted(true);\r\n            }\r\n        }\r\n    }, [orderNumber, fullOrderNumber]);\r\n\r\n    const handleSubmit = async () => {\r\n        if (!orderNumber.trim()) {\r\n            setError('Please enter your order number');\r\n            return;\r\n        }\r\n        if (rating === 0) {\r\n            setError('Please select a rating');\r\n            return;\r\n        }\r\n\r\n        try {\r\n            setSubmitting(true);\r\n            setError('');\r\n\r\n            await feedbackAPI.submit({\r\n                orderNumber: fullOrderNumber,\r\n                rating,\r\n                comment: comment.trim() || undefined\r\n            });\r\n\r\n            // Mark this order as already submitted\r\n            const submittedOrders = JSON.parse(localStorage.getItem('feedbackSubmitted') || '[]');\r\n            submittedOrders.push(fullOrderNumber);\r\n            localStorage.setItem('feedbackSubmitted', JSON.stringify(submittedOrders));\r\n\r\n            setSubmitted(true);\r\n        } catch (e: any) {\r\n            setError(e.response?.data?.error || 'Failed to submit feedback. Please try again.');\r\n        } finally {\r\n            setSubmitting(false);\r\n        }\r\n    };\r\n\r\n    const getRatingText = (r: number) => {\r\n        switch (r) {\r\n            case 1: return 'Very Poor 😞';\r\n            case 2: return 'Poor 😕';\r\n            case 3: return 'Okay 😐';\r\n            case 4: return 'Good 😊';\r\n            case 5: return 'Excellent! 🤩';\r\n            default: return 'Tap a star to rate';\r\n        }\r\n    };\r\n\r\n    const getRatingColor = (r: number) => {\r\n        if (r <= 2) return 'text-red-500';\r\n        if (r === 3) return 'text-yellow-500';\r\n        return 'text-green-500';\r\n    };\r\n\r\n    // Loading state while validating key\r\n    if (validatingKey) {\r\n        return (\r\n            <div className=\"auth-shell justify-start\">\r\n                <div className=\"auth-panel text-center\">\r\n                    <div className=\"w-12 h-12 border-4 border-yellow-400/30 border-t-yellow-400 rounded-full animate-spin mx-auto mb-4\" />\r\n                    <p className=\"text-gray-600\">Validating QR code...</p>\r\n                </div>\r\n            </div>\r\n        );\r\n    }\r\n\r\n    // Invalid or expired QR code\r\n    if (!keyValid) {\r\n        return (\r\n            <div className=\"auth-shell justify-start\">\r\n                <div className=\"auth-panel text-center\">\r\n                    <div className=\"w-20 h-20 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-6\">\r\n                        <XCircle size={48} className=\"text-red-500\" />\r\n                    </div>\r\n                    <h1 className=\"text-2xl font-bold text-gray-800 mb-2\">Invalid QR Code</h1>\r\n                    <p className=\"text-gray-600 mb-6\">\r\n                        This QR code is invalid or has expired. Please scan the latest QR code provided by the restaurant.\r\n                    </p>\r\n                    <div className=\"bg-yellow-50 border border-yellow-200 rounded-xl p-4\">\r\n                        <p className=\"text-sm text-yellow-800\">\r\n                            🍖 Ask the staff for the current QR code at <strong>JAPZ GRILL</strong>\r\n                        </p>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        );\r\n    }\r\n\r\n    if (submitted) {\r\n        return (\r\n            <div className=\"auth-shell justify-start\">\r\n                <div className=\"auth-panel text-center\">\r\n                    <div className=\"w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6\">\r\n                        <CheckCircle size={48} className=\"text-green-500\" />\r\n                    </div>\r\n                    <h1 className=\"text-2xl font-bold text-gray-800 mb-2\">Thank You!</h1>\r\n                    <p className=\"text-gray-600 mb-6\">\r\n                        Your feedback has been submitted successfully. We appreciate you taking the time to share your experience with us!\r\n                    </p>\r\n                    <div className=\"bg-yellow-50 border border-yellow-200 rounded-xl p-4\">\r\n                        <p className=\"text-sm text-yellow-800\">\r\n                            Visit us again at <strong>JAPZ GRILL</strong>\r\n                        </p>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        );\r\n    }\r\n\r\n    return (\r\n        <div className=\"auth-shell justify-start\">\r\n            <div className=\"w-full max-w-md bg-white border border-gray-200 rounded-lg p-6 md:p-8 my-auto shrink-0\">\r\n                {/* Header */}\r\n                <div className=\"text-center mb-6\">\r\n                    <img src=\"/logo.jpg\" alt=\"JAPZ GRILL\" className=\"w-16 h-16 mx-auto rounded-lg mb-3\" />\r\n                    <h1 className=\"text-2xl font-bold text-gray-800\">Rate Your Experience</h1>\r\n                    <p className=\"text-gray-500 text-sm mt-1\">at JAPZ GRILL Burger & Bistro</p>\r\n                </div>\r\n\r\n                {/* Order Number Input */}\r\n                <div className=\"mb-6\">\r\n                    <label htmlFor=\"feedback-field-1\" className=\"block text-sm font-medium text-gray-700 mb-2\">\r\n                        Order Number <span className=\"text-red-500\">*</span>\r\n                    </label>\r\n                    <div className=\"flex items-center border border-gray-300 rounded-xl overflow-hidden focus-within:ring-2 focus-within:ring-yellow-400 focus-within:border-yellow-400 transition\">\r\n                        <span className=\"px-3 py-3 bg-gray-100 text-gray-600 font-mono text-sm border-r border-gray-300 select-none whitespace-nowrap\">\r\n                            {datePrefix}-ORD-\r\n                        </span>\r\n                        <input id=\"feedback-field-1\"\r\n                            type=\"text\"\r\n                            value={orderNumber}\r\n                            onChange={(e) => {\r\n                                setOrderNumber(e.target.value);\r\n                                setError('');\r\n                            }}\r\n                            placeholder=\"12345678\"\r\n                            className=\"flex-1 min-w-0 px-3 py-3 text-base focus:outline-none\"\r\n                        />\r\n                    </div>\r\n                    <p className=\"text-xs text-gray-400 mt-1.5\">\r\n                        Enter the order number from your receipt\r\n                    </p>\r\n                </div>\r\n\r\n                {/* Star Rating */}\r\n                <div className=\"mb-6\">\r\n                    <p className=\"text-center text-gray-600 text-sm mb-4\">How would you rate your experience?</p>\r\n                    <div className=\"flex justify-center gap-2\">\r\n                        {[1, 2, 3, 4, 5].map((star) => (\r\n                            <button\r\n                                key={star}\r\n                                type=\"button\"\r\n                                onClick={() => setRating(star)}\r\n                                onMouseEnter={() => setHoverRating(star)}\r\n                                onMouseLeave={() => setHoverRating(0)}\r\n                                className=\"p-1 transition-transform hover:scale-110 active:scale-95\"\r\n                            >\r\n                                <Star\r\n                                    size={44}\r\n                                    className={`transition-colors ${star <= (hoverRating || rating)\r\n                                        ? 'fill-yellow-400 text-yellow-400'\r\n                                        : 'fill-gray-200 text-gray-200'\r\n                                        }`}\r\n                                />\r\n                            </button>\r\n                        ))}\r\n                    </div>\r\n                    <p className={`text-center mt-3 font-medium transition-colors ${getRatingColor(hoverRating || rating)}`}>\r\n                        {getRatingText(hoverRating || rating)}\r\n                    </p>\r\n                </div>\r\n\r\n                {/* Comment Field */}\r\n                <div className=\"mb-6\">\r\n                    <label htmlFor=\"feedback-field-2\" className=\"block text-sm font-medium text-gray-700 mb-2\">\r\n                        Share your thoughts (optional)\r\n                    </label>\r\n                    <textarea id=\"feedback-field-2\"\r\n                        value={comment}\r\n                        onChange={(e) => setComment(e.target.value)}\r\n                        placeholder=\"Tell us about your experience... What did you enjoy? What can we improve?\"\r\n                        rows={4}\r\n                        maxLength={500}\r\n                        className=\"w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-yellow-400 focus:border-yellow-400 resize-none transition\"\r\n                    />\r\n                    <p className=\"text-right text-xs text-gray-400 mt-1\">{comment.length}/500</p>\r\n                </div>\r\n\r\n                {/* Error Message */}\r\n                {error && (\r\n                    <div className=\"mb-4 p-3 bg-red-50 border border-red-200 rounded-xl flex items-center gap-2 text-red-700 text-sm\">\r\n                        <AlertCircle size={18} />\r\n                        {error}\r\n                    </div>\r\n                )}\r\n\r\n                {/* Submit Button */}\r\n                <button\r\n                    onClick={handleSubmit}\r\n                    disabled={submitting || rating === 0 || !orderNumber.trim()}\r\n                    className={`w-full py-4 rounded-xl font-semibold text-lg flex items-center justify-center gap-2 transition-all ${rating === 0 || !orderNumber.trim()\r\n                        ? 'bg-gray-200 text-gray-500 cursor-not-allowed'\r\n                        : 'bg-yellow-400 text-gray-900 hover:bg-yellow-500 hover:shadow-lg active:scale-[0.98]'\r\n                        }`}\r\n                >\r\n                    {submitting ? (\r\n                        <>\r\n                            <div className=\"w-5 h-5 border-2 border-gray-600/30 border-t-gray-600 rounded-full animate-spin\" />\r\n                            Submitting...\r\n                        </>\r\n                    ) : (\r\n                        <>\r\n                            <Send size={20} />\r\n                            Submit Feedback\r\n                        </>\r\n                    )}\r\n                </button>\r\n\r\n                {/* Footer */}\r\n                <p className=\"text-center text-xs text-gray-400 mt-6\">\r\n                    Your feedback helps us serve you better 💛\r\n                </p>\r\n            </div>\r\n        </div>\r\n    );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\ASUS\\Desktop\\Japz\\japz-web\\src\\services\\api.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":120,"column":41,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":120,"endColumn":44,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[4481,4484],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[4481,4484],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":125,"column":20,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":125,"endColumn":23,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[4653,4656],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[4653,4656],"text":"never"},"desc":"Use `never` instead, this 