);\r\n                }\r\n\r\n                /* ===== IMAGE STRIP ===== */\r\n                .mb-img-strip {\r\n                    display: flex;\r\n                    flex-direction: column;\r\n                    gap: clamp(0.25rem, 0.4vw, 0.5rem);\r\n                    padding: clamp(0.25rem, 0.4vw, 0.5rem) 0;\r\n                    align-items: stretch;\r\n                    justify-content: flex-start;\r\n                }\r\n                .mb-strip-img {\r\n                    width: 100%;\r\n                    object-fit: contain;\r\n                    object-position: center;\r\n                    border-radius: 0.375rem;\r\n                    border: 2px solid var(--color-brand, #FFCE1B);\r\n                    box-shadow: 0 2px 6px rgba(0,0,0,0.3);\r\n                    min-height: 0;\r\n                    /* Increase max-height so images appear larger on desktop and scale down on smaller screens */\r\n                    max-height: 30vh;\r\n                    display: block;\r\n                }\r\n\r\n                /* Fullscreen-specific tweaks so images don't over-zoom */\r\n                .mb-board:fullscreen {\r\n                    width: 100vw !important;\r\n                    height: 100vh !important;\r\n                    max-width: none !important;\r\n                    aspect-ratio: auto !important;\r\n                    border-radius: 0 !important;\r\n                }\r\n                .mb-board:fullscreen .mb-feature-img {\r\n                    max-height: 40vh;\r\n                    object-fit: contain;\r\n                    object-position: center;\r\n                }\r\n                .mb-board:fullscreen .mb-strip-img {\r\n                    max-height: 40vh;\r\n                    object-fit: contain;\r\n                    object-position: center;\r\n                }\r\n                /* Slightly increase text sizes in fullscreen for readability */\r\n                .mb-board:fullscreen .mb-section-title {\r\n                    font-size: clamp(0.62rem, 1.12vw, 0.98rem) !important;\r\n                }\r\n                .mb-board:fullscreen .mb-item-name {\r\n                    font-size: clamp(0.5rem, 0.9vw, 0.77rem) !important;\r\n                }\r\n                .mb-board:fullscreen .mb-price {\r\n                    font-size: clamp(0.5rem, 0.9vw, 0.77rem) !important;\r\n                }\r\n                .mb-board:fullscreen .mb-tagline {\r\n                    font-size: clamp(0.56rem, 1.12vw, 0.98rem) !important;\r\n                }\r\n                .mb-board:fullscreen .mb-addon-chip {\r\n                    font-size: clamp(0.44rem, 0.85vw, 0.78rem) !important;\r\n                }\r\n\r\n                /* ===== ADD-ONS FOOTER ===== */\r\n                .mb-addons-footer {\r\n                    position: relative;\r\n                    z-index: 1;\r\n                    display: flex;\r\n                    align-items: center;\r\n                    gap: clamp(0.5rem, 1vw, 1rem);\r\n                    background: rgba(0,0,0,0.85);\r\n                    border-top: 1px solid var(--color-brand, #FFCE1B);\r\n                    padding: clamp(0.3rem, 0.6vw, 0.75rem) clamp(0.5rem, 1.2vw, 1.25rem);\r\n                    flex-wrap: wrap;\r\n                    flex-shrink: 0;\r\n                }\r\n                .mb-addons-title {\r\n                    font-size: clamp(0.55rem, 1vw, 0.875rem);\r\n                    font-weight: 700;\r\n                    color: var(--color-brand, #FFCE1B);\r\n                    text-transform: uppercase;\r\n                    letter-spacing: 0.05em;\r\n                    white-space: nowrap;\r\n                }\r\n                .mb-addons-list {\r\n                    display: flex;\r\n                    flex-wrap: wrap;\r\n                    gap: clamp(0.25rem, 0.4vw, 0.5rem);\r\n                }\r\n                .mb-addon-chip {\r\n                    font-size: clamp(0.4rem, 0.7vw, 0.6875rem);\r\n                    font-weight: 700;\r\n                    padding: clamp(0.15rem, 0.3vw, 0.4rem) clamp(0.3rem, 0.6vw, 0.75rem);\r\n                    border-radius: 0.25rem;\r\n                    background: var(--color-brand, #FFCE1B);\r\n                    color: #000;\r\n                    display: flex;\r\n                    align-items: center;\r\n                    gap: 0.3rem;\r\n                    white-space: nowrap;\r\n                }\r\n                .mb-addon-unavailable {\r\n                    background: rgba(127,29,29,0.6);\r\n                    color: #fca5a5;\r\n                    text-decoration: line-through;\r\n                }\r\n\r\n                /* ===== RESPONSIVE BREAKPOINTS ===== */\r\n\r\n                /* Small screens / tablets (under 900px) — stack to 2 columns + hide image strip */\r\n                @media (max-width: 900px) {\r\n                    .mb-grid {\r\n                        grid-template-columns: 1fr 1fr;\r\n                        gap: 0.4rem;\r\n                    }\r\n                    .mb-img-strip { display: none; }\r\n                    .mb-feature-img { max-height: 15vh; }\r\n                    .mb-logo-img { max-height: 10vh; }\r\n                }\r\n\r\n                /* Very small screens / phones (under 600px) — single column */\r\n                @media (max-width: 600px) {\r\n                    .mb-grid {\r\n                        grid-template-columns: 1fr;\r\n                    }\r\n                    .mb-logo-header {\r\n                        flex-direction: column;\r\n                        text-align: center;\r\n                    }\r\n                    .mb-logo-img {\r\n                        width: 60%;\r\n                        max-height: 12vh;\r\n                    }\r\n                    .mb-feature-img { max-height: 20vh; }\r\n                    .mb-addons-footer { flex-direction: column; align-items: flex-start; }\r\n                }\r\n\r\n                /* Large displays / TVs (1920px+) — boost spacing and ensure readability */\r\n                @media (min-width: 1920px) {\r\n                    .mb-section {\r\n                        padding: clamp(0.5rem, 0.6vw, 1rem);\r\n                    }\r\n                    .mb-grid {\r\n                        gap: clamp(0.4rem, 0.5vw, 0.75rem);\r\n                    }\r\n                }\r\n\r\n                /* Ultra-wide / 4K displays (2560px+) */\r\n                @media (min-width: 2560px) {\r\n                    .mb-board {\r\n                        max-width: 3840px;\r\n                    }\r\n                }\r\n            `}</style>\r\n        </div>\r\n    );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\ASUS\\Desktop\\Japz\\japz-web\\src\\pages\\cashier\\OrderHistory.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":6,"column":42,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":6,"endColumn":45,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[306,309],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[306,309],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"prefer-const","severity":2,"message":"'all' is never reassigned. Use 'const' instead.","line":17,"column":21,"nodeType":"Identifier","messageId":"useConst","endLine":17,"endColumn":24,"fix":{"range":[685,755],"text":"const all = Array.isArray(res.data) ? res.data : (res.data?.data || []);"}},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":20,"column":50,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":20,"endColumn":53,"suggestions":[{"messageI