etStep('email-code'); setError(''); }}\r\n                                    className=\"w-full py-2 rounded-lg bg-gray-100 font-medium text-gray-700 text-sm hover:bg-gray-200 transition\"\r\n                                >\r\n                                    Back\r\n                                </button>\r\n                            </Form>\r\n                        )}\r\n                    </>\r\n                ) : (\r\n                    <div className=\"text-center py-8 flex flex-col items-center gap-4 w-full\">\r\n                        <CheckCircle size={64} className=\"text-green-500\" />\r\n                        <h2 className=\"text-xl font-bold text-gray-900\">Password Reset Successfully</h2>\r\n                        <p className=\"text-sm text-gray-600\">\r\n                            Your password has been reset. Redirecting to login...\r\n                        </p>\r\n                    </div>\r\n                )}\r\n            </div>\r\n        </div>\r\n    );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\ASUS\\Desktop\\Japz\\japz-web\\src\\pages\\RoleSelection.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\ASUS\\Desktop\\Japz\\japz-web\\src\\pages\\Welcome.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\ASUS\\Desktop\\Japz\\japz-web\\src\\pages\\admin\\Dashboard.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":39,"column":56,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":39,"endColumn":59,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1968,1971],"text":"unknown"},"desc":"Use `unknown` instead, this will force you