    const handleSubmit = async (e: React.FormEvent) => {\r\n        e.preventDefault();\r\n        if (!email) {\r\n            setError('Please enter your email address');\r\n            return;\r\n        }\r\n\r\n        setLoading(true);\r\n        setError('');\r\n        try {\r\n            await authAPI.forgotPassword(email);\r\n            setSubmitted(true);\r\n        } catch (err: any) {\r\n            setError(err.response?.data?.error || err.message || 'An error occurred');\r\n        } finally {\r\n            setLoading(false);\r\n        }\r\n    };\r\n\r\n    return (\r\n        <div className=\"auth-shell\">\r\n            <div className=\"auth-panel\">\r\n                <button\r\n                    onClick={() => navigate('/login')}\r\n                    className=\"self-start mb-4 flex items-center gap-1 text-yellow-700 hover:text-yellow-800 text-sm font-medium\"\r\n                >\r\n                    <ArrowLeft size={16} />\r\n                    Back to Login\r\n                </button>\r\n\r\n                {!submitted ? (\r\n                    <>\r\n                        <img src=\"/logo.jpg\" alt=\"JAPZ POS\" className=\"auth-logo\" />\r\n                        <h1 className=\"text-xl font-bold text-gray-900 mb-1 md:text-2xl\">Forgot Password?</h1>\r\n                        <p className=\"text-xs text-center text-gray-500 mb-6 md:text-sm\">Enter your email address and we'll send you a link to reset your password</p>\r\n\r\n                        {error && (\r\n                            <div className=\"w-full bg-red-100 px-4 py-3 rounded-lg mb-4\">\r\n                                <p className=\"text-red-600 text-sm\">{error}</p>\r\n                            </div>\r\n                        )}\r\n\r\n                        <Form className=\"w-full flex flex-col gap-3\" onSubmit={handleSubmit}>\r\n                            <div className=\"flex flex-col gap-1\">\r\n                                <label htmlFor=\"forgotpassword-field-1\" className=\"text-[13px] font-medium text-gray-900\">Email Address</label>\r\n                                <input id=\"forgotpassword-field-1\"\r\n                                    type=\"email\" required\r\n                                    placeholder=\"Enter your email\"\r\n                                    value={email}\r\n                                    onChange={(e) => setEmail(e.target.value)}\r\n                                    className=\"w-full px-3.5 py-2.5 border border-gray-200 rounded-lg bg-gray-50 text-sm text-gray-900 outline-none focus:border-brand focus:ring-2 focus:ring-brand/15 transition\"\r\n                                />\r\n                            </div>\r\n\r\n                            <button\r\n                                type=\"submit\"\r\n                                disabled={loading}\r\n                                className=\"w-full py-3 rounded-lg bg-brand font-semibold text-brand-dark text-[15px] hover:bg-yellow-400 active:bg-yellow-500 transition-all disabled:opacity-60 disabled:cursor-not-allowed\"\r\n                            >\r\n                                {loading ? 'Sending...' : 'Send Reset Link'}\r\n                            </button>\r\n                        </Form>\r\n                    </>\r\n                ) : (\r\n                    <div className=\"text-center py-8 flex flex-col items-center gap-4 w-full\">\r\n                        <CheckCircle size={64} className=\"text-green-500\" />\r\n                        <h2 className=\"text-xl font-bold text-gray-900\">Check Your Email</h2>\r\n                        <p className=\"text-sm text-gray-600\">\r\n                            We've sent a reset code to <strong>{email}</strong>\r\n                        </p>\r\n                        <p className=\"text-xs text-gray-500\">\r\n                            The code will expire in 15 minutes. Please check your spam folder if you don't see it.\r\n                        </p>\r\n                        <button\r\n                            onClick={() => navigate('/reset-password')}\r\n                            className=\"mt-6 px-6 py-2 rounded-lg bg-brand font-semibold text-brand-dark text-sm hover:shadow-md hover:shadow-yellow-300/40 transition-all\"\r\n                        >\r\n                            Enter Reset Code\r\n                        </button>\r\n                        <button\r\n                            onClick={() => navigate('/login')}\r\n                            className=\"mt-2 px-6 py-2 rounded-lg bg-gray-100 font-medium text-gray-700 text-sm hover:bg-gray-200 transition\"\r\n                        >\r\n                            Back to Login\r\n                        </button>\r\n                    </div>\r\n                )}\r\n            </div>\r\n        </div>\r\n    );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\ASUS\\Desktop\\Japz\\japz-web\\src\\pages\\Login.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":66,"column":23,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":66,"endColumn":26,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3344,3347],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[3344,3347],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import Form from '../components/Form';\r\nimport { useState } from 'react';\r\nimport { Link, useNavigate } from 'react-router-dom';\r\nimport { Eye, EyeOff, Clock } from 'lucide-react';\r\nimport { useAuth } from '../hooks/useAuth';\r\nimport { businessHoursAPI } from '../services/api';\r\n\r\nexport default function Login() {\r\n    const navigate = useNavigate();\r\n    const { login, loading, logout } = useAuth();\r\n    const [email, setEmail] = useState('');\r\n    const [password, setPassword] = useState('');\r\n    const [showPassword, setShowPassword] = useState(false);\r\n    const [error, setError] = useState('');\r\n    const [businessHoursWarning, setBusinessHoursWarning] = useState('');\r\n\r\n    const isWithinBusinessHours = (openTime: string, closeTime: string): boolean => {\r\n        const now = new Date();\r\n        const currentTime = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;\r\n        \r\n        // Compare times as strings (HH:MM format)\r\n        return currentTime >= openTime && currentTime < closeTime;\r\n    };\r\n\r\n    const handleLogin = async (e: React.FormEvent) => {\r\n        e.preventDefault();\r\n        if (!email || !password) { setError('Please enter both email and password'); return; }\r\n        \r\n        try {\r\n            setBusinessHoursWarning('');\r\n            setError('');\r\n            \r\n            // Attempt login\r\n            const result = await login(email, password);\r\n            setError('');\r\n            \r\n            // Double-check business hours for non-admin roles after login\r\n            if (result?.role === 'cashier' || result?.role === 'kitchen') {\r\n                try {\r\n                    const hoursResponse = await businessHoursAPI.get();\r\n                    const businessHours = hoursResponse.data;\r\n                    \r\n                    const openTime = businessHours.openTime?.substring(0, 5) || '09:00';\r\n                    const closeTime = businessHours.closeTime?.substring(0, 5) || '22:00';\r\n                    \r\n                    const isOpen = isWithinBusinessHours(openTime, closeTime);\r\n                    const shouldCheckHours = (result.role === 'cashier' && businessHours.applyCashier) || \r\n                                            (result.role === 'kitchen' && businessHours.applyKitchen);\r\n                    \r\n                    if (!isOpen && shouldCheckHours) {\r\n                        // Block access and clear authenticated session\r\n                        try { await logout(); } catch { /* Session cleanup continues. */ }\r\n                        setBusinessHoursWarning('Access is restricted at this time. Please contact your manager or try again during operating hours.');\r\n                        return;\r\n                    }\r\n                } catch (err) {\r\n                    console.error('Error checking business hours:', err);\r\n                }\r\n            }\r\n            \r\n            // Navigate based on role\r\n            if (result?.role === 'cashier') navigate('/cashier/pos', { replace: true });\r\n            else if (result?.role === 'kitchen') navigate('/kitchen/incoming', { replace: true });\r\n            else if (result?.role === 'inventory') navigate('/inventory/overview', { replace: true });\r\n            else navigate('/admin/dashboard', { replace: true });\r\n        } catch (err: any) { setError(err.message || 'Login failed'); }\r\n    };\r\n\r\n    return (\r\n        <div className=\"auth-shell\">\r\n            <div className=\"auth-panel\">\r\n                <img src=\"/logo.jpg\" alt=\"JAPZ POS\" className=\"auth-logo\" />\r\n                <h1 className=\"text-2xl font-semibold text-gray-900 mb-2\">Login</h1>\r\n                <p className=\"text-sm text-center text-gray-500 mb-6\">Welcome back to JAPZ POS</p>\r\n\r\n                {error && (\r\n                    <div role=\"alert\" className=\"w-full bg-red-100 px-4 py-3 rounded-lg mb-2\">\r\n                        <p className=\"text-red-600 text-sm\">{error}</p>\r\n                    </div>\r\n                )}\r\n\r\n                {businessHoursWarning && (\r\n                    <div role=\"alert\" className=\"w-full bg-orange-100 px-4 py-3 rounded-lg mb-2 flex items-start gap-3\">\r\n                        <Clock size={18} className=\"text-orange-600 flex-shrink-0 mt-0.5\" />\r\n                        <p className=\"text-orange-700 text-sm\">{businessHoursWarning}</p>\r\n                    </div>\r\n                )}\r\n\r\n                <Form className=\"w-full flex flex-col gap-2.5\" onSubmit={handleLogin}>\r\n                    <div className=\"flex flex-col gap-1\">\r\n                        <label htmlFor=\"login-field-1\" className=\"text-[13px] font-medium text-gray-900\">Email</label>\r\n                        <input id=\"login-field-1\" type=\"email\" required placeholder=\"Enter your email\" value={email}\r\n                            onChange={(e) => setEmail(e.target.value)} autoComplete=\"email\"\r\n                            className=\"w-full px-3.5 py-2.5 border border-gray-200 rounded-lg bg-gray-50 text-sm text-gray-900 outline-none focus:border-brand focus:ring-2 focus:ring-brand/15 transition\" />\r\n                    </div>\r\n\r\n                    <div className=\"flex flex-col gap-1\">\r\n                        <label htmlFor=\"login-field-2\" className=\"text-[13px] font-medium text-gray-900\">Password</label>\r\n                        <div className=\"relative flex items-center\">\r\n                            <input id=\"login-field-2\" type={showPassword ? 'text' : 'password'} required placeholder=\"Enter your password\" value={password}\r\n                                onChange={(e) => setPassword(e.target.value)} autoComplete=\"current-password\"\r\n                                className=\"w-full px-3.5 py-2.5 pr-10 border border-gray-200 rounded-lg bg-gray-50 text-sm text-gray-900 outline-none focus:border-brand focus:ring-2 focus:ring-brand/15 transition\" />\r\n                            <button type=\"button\" aria-label={showPassword ? 'Hide password' : 'Show password'} aria-pressed={showPassword} onClick={() => setShowPassword(!showPassword)}\r\n                                className=\"absolute right-3 bg-transparent border-none cursor-pointer text-gray-400 flex items-center p-1\">\r\n                                {showPassword ? <Eye size={18} /> : <EyeOff size={18} />}\r\n                            </button>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <button type=\"submit\" disabled={loading}\r\n                        className=\"w-full py-3 mt-1 rounded-lg bg-brand font-semibold text-brand-dark text-[15px] hover:bg-yellow-400 active:bg-yellow-500 transition-all disabled:opacity-60 disabled:cursor-not-allowed\">\r\n                        {loading ? 'Logging in...' : 'Login'}\r\n                    </button>\r\n                </Form>\r\n\r\n                <div className=\"flex flex-col gap-3 mt-4 text-sm text-center text-gray-500 w-full\">\r\n                    <p>\r\n                        <Link className=\"text-yellow-700 underline hover:text-yellow-800\" to=\"/forgot-password\">Forgot password?</Link>\r\n                    </p>\r\n                    <p>\r\n                        Don't have an account?{' '}\r\n                        <Link className=\"text-yellow-700 underline hover:text-yellow-800\" to=\"/register\">Register here</Link>\r\n                    </p>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\ASUS\\Desktop\\Japz\\japz-web\\src\\pages\\NotFound.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\ASUS\\Desktop\\Japz\\japz-web\\src\\pages\\Register.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":62,"column":23,"nodeType":"TS