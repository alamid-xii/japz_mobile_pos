| null>(null);\r\n\r\n    const fetchOrders = async () => {\r\n        try { \r\n            const res = await ordersAPI.getAll(); \r\n            const allOrders = Array.isArray(res.data) ? res.data : (res.data?.data || []);\r\n            const activeOnes = allOrders.filter((o: any) => \r\n                o.status === 'pending' || o.status === 'preparing' || o.status === 'ready'\r\n            );\r\n            setOrders(activeOnes); \r\n        }\r\n        catch (e) { console.error(e); }\r\n        finally { setLoading(false); }\r\n    };\r\n\r\n    useEffect(() => { \r\n        fetchOrders(); \r\n        const id = setInterval(fetchOrders, 5000); \r\n        return () => clearInterval(id); \r\n    }, []);\r\n\r\n    const filteredOrders = orders.filter(o => o.status === activeTab);\r\n\r\n    const getWaitTime = (createdAt: string) => {\r\n        const diff = Math.floor((new Date().getTime() - new Date(createdAt).getTime()) / 60000);\r\n        return diff < 1 ? 'Just now' : `${diff}m ago`;\r\n    };\r\n\r\n    const getCustomerOrders = (customerName: string) => {\r\n        return orders.filter(o => (o.customerName || 'Walk-in') === customerName);\r\n    };\r\n\r\n    if (loading && orders.length === 0) return (\r\n        <div className=\"flex flex-col items-center justify-center h-[60vh] text-gray-400 font-medium\">\r\n            <Loader2 className=\"animate-spin mb-3 text-brand\" size={40} />\r\n            <p className=\"animate-pulse\">Syncing active orders...</p>\r\n        </div>\r\n    );\r\n\r\n    return (\r\n        <div className=\"app-page\">\r\n            <div className=\"flex flex-col lg:flex-row lg:items-center justify-between gap-6 mb-8\">\r\n                <div>\r\n                    <h1 className=\"text-2xl font-bold text-yellow-900\">Active Orders</h1>\r\n                    <p className=\"text-gray-500 text-sm\">Track progress from kitchen to customer</p>\r\n                </div>\r\n                \r\n                {/* Modern Tabs */}\r\n                <div className=\"order-filters flex gap-2\" aria-label=\"Order status\">\r\n                    {[\r\n                        { id: 'pending', label: 'Pending', icon: Clock, color: 'text-orange-500', bg: 'bg-orange-50' },\r\n                        { id: 'preparing', label: 'Preparing', icon: Loader2, color: 'text-blue-500', bg: 'bg-blue-50' },\r\n                        { id: 'ready', label: 'Ready', icon: CheckCircle2, color: 'text-emerald-500', bg: 'bg-emerald-50' }\r\n                    ].map((tab) => {\r\n                        const count = orders.filter(o => o.status === tab.id).length;\r\n                        const Icon = tab.icon;\r\n                        const isActive = activeTab === tab.id;\r\n                        \r\n                        return (\r\n                            <button \r\n                                key={tab.id}\r\n                                aria-pressed={activeTab === tab.id}\r\n                                onClick={() => setActiveTab(tab.id as any)}\r\n                                className={`flex items-center gap-1 px-4 py-2 rounded-lg text-sm font-medium cursor-pointer transition ${\r\n                                    isActive ? 'border-none bg-brand text-brand-dark hover:shadow-md hover:shadow-yellow-300/40' : 'border border-gray-300 bg-white text-gray-700 hover:bg-gray-50'\r\n                                }`}\r\n                            >\r\n                                <Icon size={18} className={isActive && tab.id === 'preparing' ? 'animate-spin' : ''} />\r\n                                {tab.label}\r\n                                {count > 0 && (\r\n                                    <span className={`px-2 py-0.5 rounded-lg text-[10px] font-semibold ${\r\n                                        isActive ? 'bg-white/20 text-white' : `${tab.bg} ${tab.color}`\r\n                                    }`}>\r\n                                        {count}\r\n                                    </span>\r\n                                )}\r\n                            </button>\r\n                        );\r\n                    })}\r\n                </div>\r\n            </div>\r\n\r\n            {filteredOrders.length === 0 ? (\r\n                <div className=\"flex flex-col items-center justify-center bg-white border-2 border-dashed border-gray-200 rounded-xl py-24 text-gray-400 gap-4 shadow-sm\">\r\n                    <div className=\"bg-gray-50 p-6 rounded-full border border-gray-100\">\r\n                        <ClipboardList size={48} className=\"text-gray-200\" />\r\n                    </div>\r\n                    <div className=\"text-center px-6\">\r\n                        <p className=\"font-semibold text-xl text-gray-700 tracking-tight\">No {activeTab} orders at the moment</p>\r\n                        <p className=\"text-gray-400 max-w-xs mx-auto\">New orders will automatically appear here as they are processed</p>\r\n                    </div>\r\n                </div>\r\n            ) : (\r\n                <>\r\n                    {/* Mobile Card View */}\r\n                    <div className=\"block md:hidden\">\r\n                        <div className=\"grid grid-cols-1 gap-6\">\r\n                    {filteredOrders.map((o: any) => (\r\n                        <div key={o.id} className={`group bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm transition-colors`}>\r\n                            {/* Card Header */}\r\n                            <div className={`p-4 flex justify-between items-center ${\r\n                                activeTab === 'pending' ? 'bg-orange-50/50' : \r\n                                activeTab === 'preparing' ? 'bg-blue-50/50' : 'bg-emerald-50/50'\r\n                            }`}>\r\n                                <div>\r\n                                    <span className=\"text-[10px] text-gray-400 font-bold uppercase tracking-widest block\">ORDER</span>\r\n                                    <span className=\"font-semibold text-lg text-gray-900\">#{o.orderNumber}</span>\r\n                                </div>\r\n                                <div className=\"text-right\">\r\n                                    <span className=\"text-[10px] text-gray-400 font-bold uppercase tracking-widest block\">WAIT TIME</span>\r\n                                    <div className=\"text-xs font-semibold text-gray-700 flex items-center justify-end gap-1\">\r\n                                        <Clock size={12} className=\"text-brand\" />\r\n                                        {getWaitTime(o.createdAt)}\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n\r\n                            <div className=\"p-5 space-y-5\">\r\n                                {/* Customer Summary */}\r\n                                <div className=\"flex items-center justify-between pb-4 border-b border-gray-50\">\r\n                                    <div className=\"flex items-center gap-2\">\r\n                                        <div className=\"bg-gray-100 p-2 rounded-xl\">\r\n                                            <User size={16} className=\"text-gray-500\" />\r\n                                        </div>\r\n                                        <div>\r\n                                            <span className=\"text-[10px] text-gray-400 font-bold uppercase block tracking-tighter\">CUSTOMER</span>\r\n                                            <span className=\"text-sm font-semibold text-gray-800\">{o.customerName || 'Walk-in'}</span>\r\n                                        </div>\r\n                                    </div>\r\n                                    <div className=\"text-right\">\r\n                                        <span className=\"text-[10px] text-gray-400 font-bold uppercase block tracking-tighter\">TYPE</span>\r\n                                        <span className=\"text-xs font-semibold text-gray-700 capitalize p-1 px-2 bg-gray-50 rounded-lg border border-gray-100\">\r\n                                            {o.orderType?.replace('-', ' ') || 'Dine-in'}\r\n                                        </span>\r\n                                    </div>\r\n                                </div>\r\n\r\n                                {/* Order Items (Kitchen Style) */}\r\n                                <div className=\"space-y-3 cursor-pointer\" onClick={() => setSelectedCustomer(o.customerName || 'Walk-in')}>\r\n                                    <div className=\"flex items-center gap-2 mb-1\">\r\n                                        <UtensilsCrossed size={14} className=\"text-gray-400\" />\r\n                                        <span className=\"text-[10px] text-gray-400 font-semibold uppercase tracking-widest\">ORDER DETAIL</span>\r\n                                    </div>\r\n                                    <div className=\"space-y-2.5\">\r\n                                        {o.items?.map((item: any, idx: number) => (\r\n                                            <div key={idx} className=\"bg-slate-50/50 rounded-xl p-3 border border-slate-100 group-hover:border-brand/20 transition-colors\">\r\n                                                <div className=\"flex justify-between items-start\">\r\n                                                    <div className=\"flex-1\">\r\n                                                        <div className=\"flex items-center gap-2\">\r\n                                                            <span className=\"font-semibold text-gray-900 text-sm\">{item.name}</span>\r\n                                                            <span className=\"bg-brand/10 text-brand-dark px-1.5 py-0.5 rounded text-[10px] font-semibold italic\">x{item.quantity}</span>\r\n                                                        </div>\r\n                                                        {/* Modifiers */}\r\n                                                        <div className=\"flex flex-wrap gap-1.5 mt-1.5\">\r\n                                                            {item.modifiers?.size && (\r\n                                                                <span className=\"bg-blue-100 text-blue-700 text-[10px] font-bold px-1.5 py-0.5 rounded uppercase\">{item.modifiers.size}</span>\r\n                                                            )}\r\n                                                            {item.modifiers?.temperature && (\r\n                                                                <span className=\"bg-orange-100 text-orange-700 text-[10px] font-bold px-1.5 py-0.5 rounded uppercase\">{item.modifiers.temperature}</span>\r\n                                                            )}\r\n                                                            {item.modifiers?.flavors?.map((f: string, i: number) => (\r\n                                                                <span key={i} className=\"bg-gray-100 text-gray-600 text-[10px] font-bold px-1.5 py-0.5 rounded\">{f}</span>\r\n                                                            ))}\r\n                                                        </div>\r\n                                                    </div>\r\n                                                    <span className=\"font-semibold text-gray-400 text-xs\">₱{(item.price * item.quantity).toFixed(2)}</span>\r\n                                                </div>\r\n                                            </div>\r\n                                        ))}\r\n                                    </div>\r\n                                </div>\r\n\r\n                                {/* Notes if any */}\r\n                                {o.notes && (\r\n                                    <div className=\"bg-amber-50/50 border border-amber-100 p-3 rounded-2xl flex items-start gap-2\">\r\n                                        <StickyNote size={14} className=\"text-amber-500 mt-0.5\" />\r\n                                        <div>\r\n                                            <span className=\"text-[10px] text-amber-600 font-semibold uppercase tracking-tighter block mb-0.5\">KITCHEN NOTE</span>\r\n                                            <p className=\"text-xs text-amber-700 font-medium italic\">\"{o.notes}\"</p>\r\n                                        </div>\r\n                                    </div>\r\n                                )}\r\n\r\n                                {/* Card Footer with Total */}\r\n                                <div className=\"pt-4 border-t border-gray-100 flex items-center justify-between\">\r\n                                    <div className=\"bg-emerald-50 px-4 py-2 rounded-2xl border border-emerald-100\">\r\n                                        <span className=\"text-[10px] text-emerald-600 font-bold uppercase block tracking-tighter\">Grand Total</span>\r\n                                        <div className=\"text-2xl font-semibold text-emerald-700 tracking-tighter\">\r\n                                            ₱{Number(o.total || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}\r\n                                        </div>\r\n                                    </div>\r\n                                    <div className=\"text-right\">\r\n                                        <span className={`px-4 py-2 rounded-2xl text-[10px] font-semibold uppercase tracking-widest inline-block ${\r\n                                            o.status === 'ready' ? 'bg-emerald-500 text-white animate-bounce' : \r\n                                            o.status === 'preparing' ? 'bg-blue-500 text-white animate-pulse' : 'bg-gray-900 text-white'\r\n                                        }`}>\r\n                                            {o.status}\r\n                                        </span>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    ))}\r\n                        </div>\r\n                    </div>\r\n\r\n                    {/* Desktop Table View */}\r\n                    <div className=\"hidden md:block bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden\">\r\n                        <table className=\"w-full\">\r\n                            <thead>\r\n                                <tr className={`${\r\n                                    activeTab === 'pending' ? 'bg-yellow-50' : \r\n                                    activeTab === 'preparing' ? 'bg-yellow-50' : 'bg-yellow-50'\r\n                                } border-b border-gray-200`}>\r\n                                    <th className=\"px-6 py-4 text-left text-[10px] font-semibold uppercase tracking-widest text-yellow-700\">Order</th>\r\n                                    <th className=\"px-6 py-4 text-left text-[10px] font-semibold uppercase tracking-widest text-yellow-700\">Customer</th>\r\n                                    <th className=\"px-6 py-4 text-left text-[10px] font-semibold uppercase tracking-widest text-yellow-700\">Type</th>\r\n                                    <th className=\"px-6 py-4 text-left text-[10px] font-semibold uppercase tracking-widest text-yellow-700\">Items</th>\r\n                                    <th className=\"px-6 py-4 text-center text-[10px] font-semibold uppercase tracking-widest text-yellow-700\">Wait Time</th>\r\n                                    <th className=\"px-6 py-4 text-right text-[10px] font-semibold uppercase tracking-widest text-yellow-700\">Total</th>\r\n                                    <th className=\"px-6 py-4 text-center text-[10px] font-semibold uppercase tracking-widest text-yellow-700\">Status</th>\r\n                                </tr>\r\n                            </thead>\r\n                            <tbody>\r\n                                {filteredOrders.map((o: any, idx: number) => (\r\n                                    <tr key={o.id} className={`border-b border-gray-100 hover:bg-yellow-50 transition-colors ${idx === filteredOrders.length - 1 ? 'border-b-0' : ''}`}>\r\n                                        <td className=\"px-6 py-4\">\r\n                                            <span className=\"font-semibold text-xl text-gray-900\">#{o.orderNumber}</span>\r\n                                        </td>\r\n                                        <td className=\"px-6 py-4\">\r\n                                            <div className=\"flex items-center gap-2\">\r\n                                                <div className=\"bg-gray-100 p-2 rounded-lg\">\r\n                                                    <User size={14} className=\"text-gray-500\" />\r\n                                                </div>\r\n                                                <span className=\"text-sm font-semibold text-gray-800\">{o.customerName || 'Walk-in'}</span>\r\n                                            </div>\r\n                                        </td>\r\n                                        <td className=\"px-6 py-4\">\r\n                                            <span className=\"text-xs font-semibold text-gray-700 capitalize px-3 py-1.5 bg-gray-100 rounded-lg border border-gray-200\">\r\n                                                {o.orderType?.replace('-', ' ') || 'Dine-in'}\r\n                                            </span>\r\n                                        </td>\r\n                                        <td className=\"px-6 py-4\">\r\n                                            <div className=\"text-xs font-semibold text-gray-600 space-y-1 cursor-pointer hover:text-brand\" onClick={() => setSelectedCustomer(o.customerName || 'Walk-in')}>\r\n                                                {o.items?.slice(0, 2).map((item: any, i: number) => (\r\n                                                    <div key={i} className=\"text-gray-700\">\r\n                                                        {item.name} <span className=\"text-brand font-bold\">×{item.quantity}</span>\r\n                                                    </div>\r\n                                                ))}\r\n                                                {o.items?.length > 2 && (\r\n                                                    <div className=\"text-gray-500 italic\">+{o.items.length - 2} more</div>\r\n                                                )}\r\n                                            </div>\r\n                                        </td>\r\n                                        <td className=\"px-6 py-4 text-center\">\r\n                                            <div className=\"flex items-center justify-center gap-1 text-xs font-bold text-gray-700\">\r\n                                                <Clock size={14} className=\"text-brand\" />\r\n                                                {getWaitTime(o.createdAt)}\r\n                                            </div>\r\n                                        </td>\r\n                                        <td className=\"px-6 py-4 text-right\">\r\n                                            <span className=\"font-semibold text-lg text-emerald-700\">₱{Number(o.total || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>\r\n                                        </td>\r\n                                        <td className=\"px-6 py-4 text-center\">\r\n                                            <span className={`px-3 py-1.5 rounded-xl text-[10px] font-semibold uppercase tracking-widest inline-block ${\r\n                                                o.status === 'ready' ? 'bg-emerald-500 text-white animate-bounce' : \r\n                                                o.status === 'preparing' ? 'bg-blue-500 text-white animate-pulse' : 'bg-gray-900 text-white'\r\n                                            }`}>\r\n                                                {o.status}\r\n                                            </span>\r\n                                        </td>\r\n                                    </tr>\r\n                                ))}\r\n                            </tbody>\r\n                        </table>\r\n                    </div>\r\n                </>\r\n            )}\r\n\r\n            {/* Customer Orders Modal */}\r\n            {selectedCustomer && (\r\n                <Modal label=\"Item options\" onClose={() => setSelectedCustomer(null)} className=\"bg-white rounded-2xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto\">\r\n                        {/* Modal Header */}\r\n                        <div className=\"sticky top-0 bg-gradient-to-r from-yellow-50 to-yellow-100/50 px-6 py-4 flex items-center justify-between border-b border-yellow-200\">\r\n                            <div>\r\n                                <h2 className=\"text-xl font-bold text-yellow-900\">Orders for {selectedCustomer}</h2>\r\n                                <p className=\"text-sm text-gray-600\">Total orders: {getCustomerOrders(selectedCustomer).length}</p>\r\n                            </div>\r\n                            <button\r\n                                onClick={() => setSelectedCustomer(null)}\r\n                                className=\"p-2 hover:bg-yellow-200/50 rounded-lg transition\"\r\n                            >\r\n                                <X size={24} className=\"text-gray-600\" />\r\n                            </button>\r\n                        </div>\r\n\r\n                        {/* Modal Content */}\r\n                        <div className=\"p-6 space-y-4\">\r\n                            {getCustomerOrders(selectedCustomer).length === 0 ? (\r\n                                <div className=\"text-center py-8 text-gray-400\">\r\n                                    <p>No orders found for this customer</p>\r\n                                </div>\r\n                            ) : (\r\n                                getCustomerOrders(selectedCustomer).map((order: any) => (\r\n                                    <div key={order.id} className={`border rounded-xl p-4 transition ${\r\n                                        order.status === 'ready' ? 'border-emerald-300 bg-emerald-50' : \r\n                                        order.status === 'preparing' ? 'border-blue-300 bg-blue-50' : \r\n                                        'border-gray-200 bg-gray-50'\r\n                                    }`}>\r\n                                        <div className=\"flex items-center justify-between mb-3\">\r\n                                            <div className=\"flex items-center gap-3\">\r\n                                                <span className=\"text-xl font-semibold text-gray-900\">#{order.orderNumber}</span>\r\n                                                <span className={`px-2.5 py-0.5 rounded-lg text-[11px] font-semibold uppercase ${\r\n                                                    order.status === 'ready' ? 'bg-emerald-200 text-emerald-800' : \r\n                                                    order.status === 'preparing' ? 'bg-blue-200 text-blue-800' : \r\n                                                    'bg-gray-300 text-gray-800'\r\n                                                }`}>\r\n                                                    {order.status}\r\n                                                </span>\r\n                                            </div>\r\n                                            <div className=\"text-right\">\r\n                                                <p className=\"text-sm font-semibold text-gray-700\">{getWaitTime(order.createdAt)}</p>\r\n                                                <p className=\"text-xs text-gray-500\">{order.orderType?.replace('-', ' ') || 'Dine-in'}</p>\r\n                                            </div>\r\n                                        </div>\r\n\r\n                                        {/* Order Items */}\r\n                                        <div className=\"space-y-2 mb-3\">\r\n                                            {order.items?.map((item: any, idx: number) => (\r\n                                                <div key={idx} className=\"flex justify-between items-start bg-white p-2.5 rounded-lg border border-gray-100\">\r\n                                                    <div className=\"flex-1\">\r\n                                                        <p className=\"font-semibold text-gray-800 text-sm\">{item.name} <span className=\"text-brand font-bold\">×{item.quantity}</span></p>\r\n                                                        {item.modifiers && (Object.values(item.modifiers).filter(Boolean).length > 0) && (\r\n                                                            <div className=\"flex flex-wrap gap-1 mt-1\">\r\n                                                                {item.modifiers?.size && (\r\n                                                                    <span className=\"bg-blue-100 text-blue-700 text-[10px] font-bold px-1.5 py-0.5 rounded\">{item.modifiers.size}</span>\r\n                                                                )}\r\n                                                                {item.modifiers?.temperature && (\r\n                                                                    <span className=\"bg-orange-100 text-orange-700 text-[10px] font-bold px-1.5 py-0.5 rounded\">{item.modifiers.temperature}</span>\r\n                                                                )}\r\n                                                                {item.modifiers?.flavors?.map((f: string, i: number) => (\r\n                                                                    <span key={i} className=\"bg-gray-100 text-gray-600 text-[10px] font-bold px-1.5 py-0.5 rounded\">{f}</span>\r\n                                                                ))}\r\n                                                            </div>\r\n                                                        )}\r\n                                                    </div>\r\n                                                    <p className=\"font-semibold text-gray-700 text-sm ml-2\">₱{(item.price * item.quantity).toFixed(2)}</p>\r\n                                                </div>\r\n                                            ))}\r\n                                        </div>\r\n\r\n                                        {/* Order Notes */}\r\n                                        {order.notes && (\r\n                                            <div className=\"bg-amber-50 border border-amber-200 p-2.5 rounded-lg mb-3 flex items-start gap-2\">\r\n                                                <StickyNote size={14} className=\"text-amber-600 mt-0.5 flex-shrink-0\" />\r\n                                                <p className=\"text-xs text-amber-700 italic\">\"{order.notes}\"</p>\r\n                                            </div>\r\n                                        )}\r\n\r\n                                        {/* Order Total */}\r\n                                        <div className=\"pt-3 border-t border-gray-200 flex justify-between items-center\">\r\n                                            <span className=\"text-sm font-bold text-gray-600\">Total:</span>\r\n                                            <span className=\"text-lg font-semibold text-emerald-700\">₱{Number(order.total || 0).toFixed(2)}</span>\r\n                                        </div>\r\n                                    </div>\r\n                                ))\r\n                            )}\r\n                        </div>\r\n                    </Modal>\r\n            )}\r\n        </div>\r\n    );\r\n}\r\n\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\ASUS\\Desktop\\Japz\\japz-web\\src\\pages\\cashier\\CashPayment.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":15,"column":28,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":15,"endColumn":31,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[664,667],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[664,667],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":59,"column":43,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":59,"endColumn":46,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2877,2880],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2877,2880],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":96,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":96,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[4570,4573],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[4570,4573],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { createRequestId } from '../../utils/requestId';\r\nimport { useState } from 'react';\r\nimport { useLocation, useNavigate } from 'react-router-dom';\r\nimport { ChevronLeft } from 'lucide-react';\r\nimport { ordersAPI } from '../../services/api';\r\nimport { useAuth } from '../../hooks/useAuth';\r\n\r\nexport default function CashPayment() {\r\n    const navigate = useNavigate();\r\n    const location = useLocation();\r\n    const { user } = useAuth();\r\n    const {\r\n        total, subtotal, discount, discountId, voucherCode, voucherAmount, items, paymentMethod = 'cash',\r\n        customerName, orderType, tableNumber, deliveryAddress, notes\r\n    } = (location.state as any) || {};\r\n\r\n    const [amountReceived, setAmountReceived] = useState('');\r\n    const [processing, setProcessing] = useState(false);\r\n    const [error, setError] = useState('');\r\n    const [clientRequestId] = useState(createRequestId());\r\n    const [orderNumber] = useState(() => `ORD-${Date.now()}-${createRequestId().slice(0, 8)}`);\r\n\r\n    const totalNum = Number(total || 0);\r\n    const received = Number(amountReceived || 0);\r\n    const change = received - totalNum;\r\n    const isCash = paymentMethod === 'cash';\r\n    const isFree = totalNum === 0;\r\n    const isValidPayment = isFree || (isCash ? received >= totalNum : true);\r\n\r\n    const quickAmounts = [50, 100, 200, 500, 1000];\r\n\r\n    if (total === undefined || total === null) return <div className=\"flex flex-col items-center justify-center h-full text-gray-500 gap-2 py-8\"><h1 className=\"text-xl font-semibold text-gray-900\">No order to check out</h1><p>Add items from the menu to start an order.</p><button className=\"mt-4 px-5 py-3 bg-brand text-brand-dark rounded-md font-semibold\" onClick={() => navigate('/cashier/pos')}>Back to POS</button></div>;\r\n\r\n    const handlePay = async () => {\r\n        if (!isValidPayment || processing) return;\r\n        setError('');\r\n\r\n        setProcessing(true);\r\n        try {\r\n            const itemsArray = Array.isArray(items) ? items : [];\r\n            const orderData = {\r\n                orderNumber,\r\n                clientRequestId,\r\n                cashierId: user?.id,\r\n                cashier: user?.name,\r\n                customerName,\r\n                total: totalNum,\r\n                subtotal: Number(subtotal || totalNum),\r\n                discount: Number(discount || 0),\r\n                discountId: discountId || null,\r\n                voucherCode: voucherCode || null,\r\n                voucherAmount: voucherAmount ? Number(voucherAmount) : null,\r\n                payment: {\r\n                    method: paymentMethod as 'cash' | 'card' | 'digital',\r\n                    amount: totalNum,\r\n                    amountReceived: isCash ? received : totalNum,\r\n                    change: isCash ? Math.round(change * 100) / 100 : 0\r\n                },\r\n                items: itemsArray.map((i: any) => ({\r\n                    id: i.id.toString(),\r\n                    name: i.name,\r\n                    price: i.itemPrice || i.price,\r\n                    quantity: i.quantity,\r\n                    total: (i.itemPrice || i.price) * i.quantity,\r\n                    modifiers: { size: i.selectedSize || null, flavor: i.selectedFlavor || null, temperature: i.selectedTemperature || null }\r\n                })),\r\n                status: 'pending',\r\n                orderType: orderType || null,\r\n                tableNumber: tableNumber || null,\r\n                deliveryAddress: deliveryAddress || null,\r\n                notes: notes || null,\r\n            };\r\n            await ordersAPI.create(orderData);\r\n            localStorage.removeItem('cashierCart');\r\n            navigate('/cashier/receipt', {\r\n                state: {\r\n                    orderNumber,\r\n                    total: totalNum,\r\n                    subtotal: Number(subtotal || totalNum),\r\n                    discount: Number(discount || 0),\r\n                    discountId: discountId || null,\r\n                    voucherCode: voucherCode || null,\r\n                    voucherAmount: voucherAmount ? Number(voucherAmount) : null,\r\n                    amountReceived: isCash ? received : totalNum,\r\n                    change: isCash ? Math.round(change * 100) / 100 : 0,\r\n                    items,\r\n                    method: paymentMethod,\r\n                    customerName,\r\n                    orderType,\r\n                    tableNumber,\r\n                    deliveryAddress,\r\n                    cashier: user?.name\r\n                },\r\n                replace: true\r\n            });\r\n        } catch (e: any) {\r\n            console.error('Payment error:', e);\r\n            setError(e.response?.data?.error || 'Payment could not be saved. Retry the payment or return to the cart.');\r\n        }\r\n        finally { setProcessing(false); }\r\n    };\r\n\r\n    return (\r\n        <div className=\"min-h-full flex flex-col items-center p-5 md:p-8 md:pt-10 overflow-y-auto\">\r\n            <div className=\"w-full max-w-md\">\r\n                <button className=\"inline-flex items-center gap-1.5 px-4 py-2 border border-gray-200 rounded-lg bg-white hover:bg-gray-50 cursor-pointer font-medium text-sm mb-4\"\r\n                    onClick={() => navigate(-1)}>\r\n                    <ChevronLeft size={18} /> Back\r\n                </button>\r\n                <h1 className=\"text-xl md:text-2xl font-bold text-center capitalize\">{paymentMethod} Payment</h1>\r\n\r\n                {error && <div role=\"alert\" className=\"p-3 my-4 rounded-md bg-red-50 border border-red-200 text-red-800 text-sm\">{error}<button className=\"block min-h-11 mt-2 underline\" onClick={() => navigate('/cashier/pos')}>Return to cart</button></div>}\r\n                {/* Order Info Summary */}\r\n                <div className=\"bg-gray-50 rounded-xl p-4 my-4\">\r\n                    <div className=\"flex justify-between py-1\">\r\n                        <span className=\"text-gray-500\">Customer:</span>\r\n                        <span className=\"font-semibold\">{customerName}</span>\r\n                    </div>\r\n                    <div className=\"flex justify-between py-1\">\r\n                        <span className=\"text-gray-500\">Order Type:</span>\r\n                        <span className=\"font-semibold capitalize\">{orderType}</span>\r\n                    </div>\r\n                    {tableNumber && (\r\n                        <div className=\"flex justify-between py-1\">\r\n                            <span className=\"text-gray-500\">Table:</span>\r\n                            <span className=\"font-semibold\">{tableNumber}</span>\r\n                        </div>\r\n                    )}\r\n                    {deliveryAddress && (\r\n                        <div className=\"flex justify-between py-1\">\r\n                            <span className=\"text-gray-500\">Address:</span>\r\n                            <span className=\"font-semibold text-right max-w-[60%]\">{deliveryAddress}</span>\r\n                        </div>\r\n                    )}\r\n                    <div className=\"flex justify-between py-2 border-t border-gray-200 mt-2 pt-2\">\r\n                        <span className=\"text-gray-500\">Amount Due:</span>\r\n                        <span className=\"text-xl font-bold text-brand-dark\">₱{totalNum.toFixed(2)}</span>\r\n                    </div>\r\n                </div>\r\n\r\n                {/* Cash Payment - Amount Received */}\r\n                {isCash && !isFree && (\r\n                    <>\r\n                        <div className=\"mb-4\">\r\n                            <label htmlFor=\"cashpayment-field-1\" className=\"text-sm font-semibold text-gray-700 mb-2 block\">Amount Received</label>\r\n                            <input id=\"cashpayment-field-1\"\r\n                                type=\"number\"\r\n                                placeholder=\"0.00\"\r\n                                value={amountReceived}\r\n                                onChange={(e) => setAmountReceived(e.target.value)}\r\n                                className={`w-full py-4 text-2xl font-bold text-center border-2 rounded-xl outline-none font-[inherit] ${received > 0 ? (isValidPayment ? 'border-emerald-500' : 'border-red-400') : 'border-gray-200'\r\n                                    } focus:border-brand`}\r\n                            />\r\n                        </div>\r\n\r\n                        {/* Quick Amounts */}\r\n                        <div className=\"mb-4\">\r\n                            <p className=\"text-sm font-semibold text-gray-500 mb-2\">Quick Amounts</p>\r\n                            <div className=\"grid grid-cols-5 gap-2\">\r\n                                {quickAmounts.map(amt => (\r\n                                    <button\r\n                                        key={amt}\r\n                                        onClick={() => setAmountReceived(amt.toString())}\r\n                                        className={`py-2.5 rounded-xl font-semibold text-sm transition font-[inherit] border ${amountReceived === amt.toString()\r\n                                                ? 'bg-brand border-brand text-brand-dark'\r\n                                                : 'bg-white border-gray-200 hover:bg-yellow-50 hover:border-brand cursor-pointer'\r\n                                            }`}\r\n                                    >\r\n                                        ₱{amt}\r\n                                    </button>\r\n                                ))}\r\n                            </div>\r\n                        </div>\r\n\r\n                        {/* Change Display */}\r\n                        {received > 0 && (\r\n                            <div className=\"bg-gray-50 rounded-xl p-4 mb-6\">\r\n                                <div className=\"flex justify-between py-1\">\r\n                                    <span className=\"text-gray-500\">Amount Received:</span>\r\n                                    <span className=\"font-semibold\">₱{received.toFixed(2)}</span>\r\n                                </div>\r\n                                <div className=\"flex justify-between py-1 border-b border-gray-200 pb-2\">\r\n                                    <span className=\"text-gray-500\">Amount Due:</span>\r\n                                    <span className=\"font-semibold\">₱{totalNum.toFixed(2)}</span>\r\n                                </div>\r\n                                <div className=\"flex justify-between py-2 mt-1\">\r\n                                    <span className=\"font-bold\">Change:</span>\r\n                                    <span className={`font-bold ${isValidPayment ? 'text-emerald-500' : 'text-red-500'}`}>\r\n                                        {isValidPayment ? '+' : '-'}₱{Math.abs(change).toFixed(2)}\r\n                                    </span>\r\n                                </div>\r\n                            </div>\r\n                        )}\r\n                    </>\r\n                )}\r\n\r\n                {/* Free Order Message */}\r\n                {isFree && (\r\n                    <div className=\"bg-emerald-50 border-2 border-emerald-300 rounded-xl p-6 mb-6 text-center\">\r\n                        <p className=\"text-emerald-700 font-bold text-lg\">✓ Order is Complimentary</p>\r\n                        <p className=\"text-emerald-600 text-sm mt-2\">No charge due to applied discount/voucher</p>\r\n                        <p className=\"text-emerald-500 text-2xl font-bold mt-3\">₱0.00</p>\r\n                    </div>\r\n                )}\r\n\r\n                {/* Card/Digital Payment Info */}\r\n                {!isCash && !isFree && (\r\n                    <div className=\"bg-emerald-50 border border-emerald-200 rounded-xl p-4 mb-6 text-center\">\r\n                        <p className=\"text-emerald-700 font-medium\">Ready to process {paymentMethod} payment</p>\r\n                        <p className=\"text-emerald-600 text-sm mt-1\">Amount: ₱{totalNum.toFixed(2)}</p>\r\n                    </div>\r\n                )}\r\n\r\n                {/* Complete Button */}\r\n                <button\r\n                    disabled={!isValidPayment || processing}\r\n                    onClick={handlePay}\r\n                    className={`w-full py-4 rounded-xl text-lg font-semibold transition font-[inherit] ${isValidPayment && !processing\r\n                            ? 'bg-brand text-brand-dark cursor-pointer hover:shadow-md hover:shadow-yellow-300/40'\r\n                            : 'bg-gray-200 text-gray-400 cursor-not-allowed'\r\n                        }`}\r\n                >\r\n                    {processing ? 'Processing...' : isFree ? 'Complete Order (Free)' : 'Complete Transaction'}\r\n                </button>\r\n            </div>\r\n        </div>\r\n    );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\ASUS\\Desktop\\Japz\\japz-web\\src\\pages\\cashier\\MenuBoard.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":10,"column":32,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":10,"endColumn":35,"suggestions":[{"messageId":"suggestUnknown","