Initialized) {\r\n        return (\r\n            <div className=\"min-h-screen flex items-center justify-center bg-gray-100\">\r\n                <div className=\"animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-yellow-500\"></div>\r\n            </div>\r\n        );\r\n    }\r\n\r\n    // If user is logged in, redirect to their dashboard\r\n    if (user) {\r\n        const roleRedirects = {\r\n            admin: '/admin/dashboard',\r\n            cashier: '/cashier/pos',\r\n            kitchen: '/kitchen/incoming',\n            inventory: '/inventory/overview',\n        };\r\n        const from = (location.state as any)?.from?.pathname || roleRedirects[user.role];\r\n        return <Navigate to={from} replace />;\r\n    }\r\n\r\n    // Not logged in - show the public page\r\n    return <>{children}</>;\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\ASUS\\Desktop\\Japz\\japz-web\\src\\components\\RouteAnnouncement.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\ASUS\\Desktop\\Japz\\japz-web\\src\\components\\admin\\DashboardCharts.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\ASUS\\Desktop\\Japz\\japz-web\\src\\components\\admin\\index.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\ASUS\\Desktop\\Japz\\japz-web\\src\\features\\inventory\\CountsLosses.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\ASUS\\Desktop\\Japz\\japz-web\\src\\features\\inventory\\Guide.tsx","messages