# Local backend API
VITE_API_URL=http://localhost:3000

# Optional: leave blank to use the free OpenStreetMap delivery map.
# Google navigation links work without any key. Embed requires your own
# billing-enabled Google Cloud project with Maps Embed API enabled; restrict
# the browser key to Maps Embed API and your deployed website origins.
# Embed requests are free: https://developers.google.com/maps/documentation/embed/usage-and-billing
VITE_GOOGLE_MAPS_EMBED_API_KEY=
