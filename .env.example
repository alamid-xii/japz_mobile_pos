# Docker Compose only. Generate .env with: npm run docker:setup
FRONTEND_PORT=8080
BACKEND_PORT=5000
MYSQL_PORT=3307
PHPMYADMIN_PORT=8081
MYSQL_PASSWORD=replace-with-a-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-root-password
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@japz.local
ADMIN_PASSWORD=replace-with-a-strong-manager-password
# Optional: manager password-recovery email support.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=
